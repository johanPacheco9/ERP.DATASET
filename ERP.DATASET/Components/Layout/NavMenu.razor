@rendermode pageRenderMode

<aside class="@(IsCollapsed ? "w-[64px]" : "w-[250px]") min-h-screen flex flex-col flex-shrink-0 bg-white/70 backdrop-blur-xl border-r border-slate-200 transition-[width] ">

    <!-- Header -->
    <div class="h-[58px] flex items-center justify-between px-3.5 border-b border-slate-200 flex-shrink-0 gap-2.5 bg-white/60 backdrop-blur-xl">
        <div class="w-9 h-9 rounded-lg bg-black flex items-center justify-center font-extrabold text-base text-white flex-shrink-0 shadow-sm">
            N
        </div>
        @if (!IsCollapsed)
        {
            <div class="flex-1 overflow-hidden">
                <span class="block text-[13px] font-bold text-slate-900 tracking-wide leading-tight whitespace-nowrap">NEXUS ERP</span>
                <span class="block text-[10px] text-slate-400 font-medium mt-px whitespace-nowrap">Punto de Venta</span>
            </div>
        }
        <button @onclick="Toggle" type="button" aria-label="Colapsar menÃº"
            class="w-[22px] h-[26px] rounded-md border border-slate-200 bg-white text-slate-400 flex items-center justify-center text-xs flex-shrink-0 transition-all duration-200 hover:bg-slate-50 hover:text-slate-600 hover:scale-110">
            <i class="bi @(IsCollapsed ? "bi-chevron-right" : "bi-chevron-left")"></i>
        </button>
    </div>

    <!-- Nav -->
    <nav class="flex-1 overflow-y-auto px-2 py-3 flex flex-col gap-2 [scrollbar-width:thin]">

        <!-- GENERAL -->
        <div class="flex flex-col gap-0.5">
            @if (!IsCollapsed)
            {
                <div class="px-2.5 pb-1.5 text-[10px] font-bold tracking-[0.09em] text-slate-400 uppercase">General</div>
            }
            <NavLink href="" Match="NavLinkMatch.All"
                class="group flex items-center gap-2.5 px-2.5 py-2 rounded-lg border-l-[3px] border-transparent text-slate-500 text-[12.5px] font-medium no-underline transition-all duration-200 hover:bg-slate-100/70 hover:text-slate-800 hover:translate-x-0.5 [&.active]:bg-slate-900/5 [&.active]:border-slate-900 [&.active]:text-slate-900 [&.active]:font-semibold">
                <i class="bi bi-grid text-[16px] w-[18px] flex-shrink-0 text-blue-500 transition-transform duration-200 group-hover:scale-110"></i>
                @if (!IsCollapsed) { <span>Inicio</span> }
            </NavLink>
        </div>

        <!-- VENTAS & POS -->
        <div class="flex flex-col gap-0.5 pt-4 border-t border-slate-200/70">
            @if (!IsCollapsed)
            {
                <div class="px-2.5 pb-1.5 text-[10px] font-bold tracking-[0.09em] text-slate-400 uppercase flex items-center">
                    Ventas &amp; POS
                    <span class="ml-1.5 text-[8px] px-1.5 py-px rounded-full bg-indigo-50 text-indigo-600 border border-indigo-100 font-bold tracking-[0.04em] uppercase">Factus</span>
                </div>
            }
            <NavLink href="ventas/nueva"
                class="group flex items-center gap-2.5 px-2.5 py-2 rounded-lg border-l-[3px] border-transparent text-slate-500 text-[12.5px] font-medium no-underline transition-all duration-200 hover:bg-slate-100/70 hover:text-slate-800 hover:translate-x-0.5 [&.active]:bg-slate-900/5 [&.active]:border-slate-900 [&.active]:text-slate-900 [&.active]:font-semibold">
                <i class="bi bi-upc-scan text-[15px] w-[18px] flex-shrink-0 text-blue-500 transition-transform duration-200 group-hover:scale-110"></i>
                @if (!IsCollapsed) { <span>Terminal POS (Caja)</span> }
            </NavLink>
            <NavLink href="ventas"
                class="group flex items-center gap-2.5 px-2.5 py-2 rounded-lg border-l-[3px] border-transparent text-slate-500 text-[12.5px] font-medium no-underline transition-all duration-200 hover:bg-slate-100/70 hover:text-slate-800 hover:translate-x-0.5 [&.active]:bg-slate-900/5 [&.active]:border-slate-900 [&.active]:text-slate-900 [&.active]:font-semibold">
                <i class="bi bi-receipt text-[15px] w-[18px] flex-shrink-0 text-blue-500 transition-transform duration-200 group-hover:scale-110"></i>
                @if (!IsCollapsed) { <span>Historial ventas</span> }
            </NavLink>
            <NavLink href="cartera"
                class="group flex items-center gap-2.5 px-2.5 py-2 rounded-lg border-l-[3px] border-transparent text-slate-500 text-[12.5px] font-medium no-underline transition-all duration-200 hover:bg-slate-100/70 hover:text-slate-800 hover:translate-x-0.5 [&.active]:bg-slate-900/5 [&.active]:border-slate-900 [&.active]:text-slate-900 [&.active]:font-semibold">
                <i class="bi bi-cash-stack text-[15px] w-[18px] flex-shrink-0 text-emerald-500 transition-transform duration-200 group-hover:scale-110"></i>
                @if (!IsCollapsed) { <span>Cartera y cobros</span> }
            </NavLink>
            <NavLink href="clientes"
                class="group flex items-center gap-2.5 px-2.5 py-2 rounded-lg border-l-[3px] border-transparent text-slate-500 text-[12.5px] font-medium no-underline transition-all duration-200 hover:bg-slate-100/70 hover:text-slate-800 hover:translate-x-0.5 [&.active]:bg-slate-900/5 [&.active]:border-slate-900 [&.active]:text-slate-900 [&.active]:font-semibold">
                <i class="bi bi-people text-[15px] w-[18px] flex-shrink-0 text-indigo-500 transition-transform duration-200 group-hover:scale-110"></i>
                @if (!IsCollapsed) { <span>Clientes / DIAN</span> }
            </NavLink>
            <NavLink href="caja/abrir"
                class="group flex items-center gap-2.5 px-2.5 py-2 rounded-lg border-l-[3px] border-transparent text-slate-500 text-[12.5px] font-medium no-underline transition-all duration-200 hover:bg-slate-100/70 hover:text-slate-800 hover:translate-x-0.5 [&.active]:bg-slate-900/5 [&.active]:border-slate-900 [&.active]:text-slate-900 [&.active]:font-semibold">
                <i class="bi bi-shop text-[15px] w-[18px] flex-shrink-0 text-blue-500 transition-transform duration-200 group-hover:scale-110"></i>
                @if (!IsCollapsed) { <span>Caja / DIAN</span> }
            </NavLink>
        </div>

        <!-- INVENTARIO -->
        <div class="flex flex-col gap-0.5 pt-4 border-t border-slate-200/70">
            @if (!IsCollapsed)
            {
                <div class="px-2.5 pb-1.5 text-[10px] font-bold tracking-[0.09em] text-slate-400 uppercase">Inventario</div>
            }
            <NavLink href="inventario"
                class="group flex items-center gap-2.5 px-2.5 py-2 rounded-lg border-l-[3px] border-transparent text-slate-500 text-[12.5px] font-medium no-underline transition-all duration-200 hover:bg-slate-100/70 hover:text-slate-800 hover:translate-x-0.5 [&.active]:bg-slate-900/5 [&.active]:border-slate-900 [&.active]:text-slate-900 [&.active]:font-semibold">
                <i class="bi bi-box-seam text-[15px] w-[18px] flex-shrink-0 text-slate-400 transition-transform duration-200 group-hover:scale-110"></i>
                @if (!IsCollapsed) { <span>Modulo general</span> }
            </NavLink>
            <NavLink href="ProductosDashboard"
                class="group flex items-center gap-2.5 px-2.5 py-2 rounded-lg border-l-[3px] border-transparent text-slate-500 text-[12.5px] font-medium no-underline transition-all duration-200 hover:bg-slate-100/70 hover:text-slate-800 hover:translate-x-0.5 [&.active]:bg-slate-900/5 [&.active]:border-slate-900 [&.active]:text-slate-900 [&.active]:font-semibold">
                <i class="bi bi-tags text-[15px] w-[18px] flex-shrink-0 text-violet-500 transition-transform duration-200 group-hover:scale-110"></i>
                @if (!IsCollapsed) { <span>Productos</span> }
            </NavLink>
            <NavLink href="categorias"
                class="group flex items-center gap-2.5 px-2.5 py-2 rounded-lg border-l-[3px] border-transparent text-slate-500 text-[12.5px] font-medium no-underline transition-all duration-200 hover:bg-slate-100/70 hover:text-slate-800 hover:translate-x-0.5 [&.active]:bg-slate-900/5 [&.active]:border-slate-900 [&.active]:text-slate-900 [&.active]:font-semibold">
                <i class="bi bi-folder2 text-[15px] w-[18px] flex-shrink-0 text-violet-400 transition-transform duration-200 group-hover:scale-110"></i>
                @if (!IsCollapsed) { <span>Categori­as</span> }
            </NavLink>
            <NavLink href="bodegas"
                class="group flex items-center gap-2.5 px-2.5 py-2 rounded-lg border-l-[3px] border-transparent text-slate-500 text-[12.5px] font-medium no-underline transition-all duration-200 hover:bg-slate-100/70 hover:text-slate-800 hover:translate-x-0.5 [&.active]:bg-slate-900/5 [&.active]:border-slate-900 [&.active]:text-slate-900 [&.active]:font-semibold">
                <i class="bi bi-building text-[15px] w-[18px] flex-shrink-0 text-teal-500 transition-transform duration-200 group-hover:scale-110"></i>
                @if (!IsCollapsed) { <span>Bodegas</span> }
            </NavLink>
            <NavLink href="movimientos"
                class="group flex items-center gap-2.5 px-2.5 py-2 rounded-lg border-l-[3px] border-transparent text-slate-500 text-[12.5px] font-medium no-underline transition-all duration-200 hover:bg-slate-100/70 hover:text-slate-800 hover:translate-x-0.5 [&.active]:bg-slate-900/5 [&.active]:border-slate-900 [&.active]:text-slate-900 [&.active]:font-semibold">
                <i class="bi bi-arrow-left-right text-[15px] w-[18px] flex-shrink-0 text-indigo-500 transition-transform duration-200 group-hover:scale-110"></i>
                @if (!IsCollapsed) { <span>Movimientos Kardex</span> }
            </NavLink>
            <NavLink href="stock-alertas"
                class="group flex items-center gap-2.5 px-2.5 py-2 rounded-lg border-l-[3px] border-transparent text-slate-500 text-[12.5px] font-medium no-underline transition-all duration-200 hover:bg-slate-100/70 hover:text-slate-800 hover:translate-x-0.5 [&.active]:bg-slate-900/5 [&.active]:border-slate-900 [&.active]:text-slate-900 [&.active]:font-semibold">
                <i class="bi bi-exclamation-triangle text-[15px] w-[18px] flex-shrink-0 text-amber-500 transition-transform duration-200 group-hover:scale-110"></i>
                @if (!IsCollapsed) { <span>Alertas de stock</span> }
            </NavLink>
            <NavLink href="unidades"
                class="group flex items-center gap-2.5 px-2.5 py-2 rounded-lg border-l-[3px] border-transparent text-slate-500 text-[12.5px] font-medium no-underline transition-all duration-200 hover:bg-slate-100/70 hover:text-slate-800 hover:translate-x-0.5 [&.active]:bg-slate-900/5 [&.active]:border-slate-900 [&.active]:text-slate-900 [&.active]:font-semibold">
                <i class="bi bi-qr-code-scan text-[15px] w-[18px] flex-shrink-0 text-sky-500 transition-transform duration-200 group-hover:scale-110"></i>
                @if (!IsCollapsed) { <span>Unidades fi­sicas</span> }
            </NavLink>
            <NavLink href="auditorias"
                class="group flex items-center gap-2.5 px-2.5 py-2 rounded-lg border-l-[3px] border-transparent text-slate-500 text-[12.5px] font-medium no-underline transition-all duration-200 hover:bg-slate-100/70 hover:text-slate-800 hover:translate-x-0.5 [&.active]:bg-slate-900/5 [&.active]:border-slate-900 [&.active]:text-slate-900 [&.active]:font-semibold">
                <i class="bi bi-clipboard-check text-[15px] w-[18px] flex-shrink-0 text-purple-500 transition-transform duration-200 group-hover:scale-110"></i>
                @if (!IsCollapsed) { <span>Auditori­as</span> }
            </NavLink>
            <NavLink href="proveedores"
                class="group flex items-center gap-2.5 px-2.5 py-2 rounded-lg border-l-[3px] border-transparent text-slate-500 text-[12.5px] font-medium no-underline transition-all duration-200 hover:bg-slate-100/70 hover:text-slate-800 hover:translate-x-0.5 [&.active]:bg-slate-900/5 [&.active]:border-slate-900 [&.active]:text-slate-900 [&.active]:font-semibold">
                <i class="bi bi-truck text-[15px] w-[18px] flex-shrink-0 text-slate-400 transition-transform duration-200 group-hover:scale-110"></i>
                @if (!IsCollapsed) { <span>Proveedores</span> }
            </NavLink>
        </div>

    </nav>

    <!-- Footer -->
    <div class="p-2 border-t border-slate-200 flex-shrink-0 bg-white/50">
        <div class="flex items-center gap-2.5 px-2.5 py-2 bg-slate-50 rounded-lg border border-slate-200 transition-all duration-200 hover:shadow-sm">
            <div class="w-7 h-7 rounded-md bg-blue-100 border border-blue-200 flex items-center justify-center text-[11px] font-bold text-blue-700 flex-shrink-0">
                C
            </div>
            @if (!IsCollapsed)
            {
                <div class="flex flex-col overflow-hidden">
                    <span class="text-[11px] font-semibold text-slate-800 leading-tight whitespace-nowrap overflow-hidden text-ellipsis">Caja Principal</span>
                    <span class="flex items-center gap-1 text-[10px] text-emerald-600 mt-px">
                        <span class="w-[5px] h-[5px] rounded-full bg-emerald-500 flex-shrink-0"></span>
                        Conectado
                    </span>
                </div>
            }
        </div>
    </div>

</aside>

@code {
    private bool IsCollapsed;
    private static IComponentRenderMode pageRenderMode = InteractiveServer;
    void Toggle() => IsCollapsed = !IsCollapsed;
}

