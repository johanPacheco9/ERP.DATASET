@rendermode pageRenderMode

<nav class="sidebar @(IsCollapsed ? "collapsed" : "")">
    <div class="sidebar-header d-flex justify-content-between align-items-center px-3">
        <span class="logo">ERP.DATASET</span>
        <button class="btn sidebar-toggle shadow-sm"
                @onclick="Toggle">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-list" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5" />
            </svg>
        </button>
    </div>
  
    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
        <i class="bi bi-house"></i>
        <span class="text">Inicio</span>
    </NavLink>

    <NavLink class="nav-link" href="ProductManagement">
        <i class="bi bi-box"></i>
        <span class="text">Operativo</span>
    </NavLink>

    <NavLink class="nav-link" href="clientes">
        <i class="bi bi-people"></i>
        <span class="text">Clientes</span>
    </NavLink>
</nav>

@code {
    private bool IsCollapsed;
    private static IComponentRenderMode pageRenderMode = InteractiveServer;
    void Toggle() => IsCollapsed = !IsCollapsed;

    private async Task Boton()
    {
        Console.WriteLine("Interacive");
    }
}



