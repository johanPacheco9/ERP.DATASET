@inherits LayoutComponentBase

<div class="min-h-screen bg-slate-50 flex font-sans antialiased text-slate-900">
    <NavMenu />

    <div class="flex-1 flex flex-col min-w-0">
        <!-- TopBar Header -->
        <header class="h-16 bg-white border-b border-slate-200 px-4 sm:px-6 flex items-center justify-between sticky top-0 z-30 shadow-xs">
            <!-- Left Info -->
            <div class="flex items-center gap-2 text-xs text-slate-500 font-medium">
                <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span>
                <span class="font-semibold text-slate-700">ERP DATASET</span>
                <span class="text-slate-300">/</span>
                <span class="text-slate-400 hidden sm:inline">Punto de Venta & Gestión</span>
            </div>

            <!-- Right Actions & User Profile -->
            <div class="flex items-center gap-3">
                <AuthorizeView>
                    <Authorized>
                        <div class="flex items-center gap-3 pr-3 border-r border-slate-200">
                            <div class="w-8 h-8 rounded-full bg-blue-100 text-blue-800 flex items-center justify-center font-bold text-xs uppercase border border-blue-200">
                                @(context.User.Identity?.Name?.Length > 0 ? context.User.Identity.Name[0].ToString() : "U")
                            </div>
                            <div class="hidden sm:block text-left">
                                <span class="text-xs font-bold text-slate-800 block leading-tight truncate max-w-[150px]">
                                    @(context.User.Identity?.Name ?? "Usuario")
                                </span>
                                <span class="text-[9px] px-1.5 py-0.2 rounded font-semibold inline-block @GetRoleBadgeClass(context.User)">
                                    @GetRoleDisplayName(context.User)
                                </span>
                            </div>
                        </div>

                        <!-- Botón Cerrar Sesión -->
                        <a href="/logout" 
                           title="Cerrar Sesión del Sistema"
                           class="px-3 py-1.5 rounded-xl text-xs font-semibold text-rose-700 bg-rose-50 hover:bg-rose-100 border border-rose-200 transition-colors flex items-center gap-1.5">
                            <i class="bi bi-box-arrow-right"></i>
                            <span class="hidden sm:inline">Cerrar Sesión</span>
                        </a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="px-3.5 py-1.5 rounded-xl text-xs font-bold text-slate-950 bg-emerald-400 hover:bg-emerald-300 transition-colors flex items-center gap-1.5">
                            <i class="bi bi-box-arrow-in-right"></i>
                            <span>Iniciar Sesión</span>
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <!-- Main Content Body -->
        <main class="flex-1 bg-[#eef0f8] p-4 sm:p-6 overflow-y-auto">
            @Body
        </main>
    </div>
</div>

@code {
    private string GetRoleDisplayName(System.Security.Claims.ClaimsPrincipal user)
    {
        if (user.IsInRole(AppPermissions.Roles.Admin)) return "Administrador";
        if (user.IsInRole(AppPermissions.Roles.Supervisor)) return "Supervisor";
        if (user.IsInRole(AppPermissions.Roles.Cashier)) return "Cajero";
        return "Operador";
    }

    private string GetRoleBadgeClass(System.Security.Claims.ClaimsPrincipal user)
    {
        if (user.IsInRole(AppPermissions.Roles.Admin)) return "bg-purple-100 text-purple-800 border border-purple-200";
        if (user.IsInRole(AppPermissions.Roles.Supervisor)) return "bg-amber-100 text-amber-800 border border-amber-200";
        if (user.IsInRole(AppPermissions.Roles.Cashier)) return "bg-emerald-100 text-emerald-800 border border-emerald-200";
        return "bg-slate-100 text-slate-700 border border-slate-200";
    }
}
