@page "/ventas/nueva"
@page "/ventas/pos"
@using ERP.TRAN.CrossLayers.API.Pos.Payments.Enums
@using ERP.TRAN.CrossLayers.API.Pos.Clients.Enums
@rendermode InteractiveServer

<div class="max-w-[1600px] mx-auto space-y-4">
    <!-- Header POS Blanco & Corporativo -->
    <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-xs flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-blue-600 text-white flex items-center justify-center text-xl shadow-xs">
                <i class="bi bi-cart3"></i>
            </div>
            <div>
                <h1 class="text-lg font-bold text-slate-900 tracking-tight flex items-center gap-2">
                    Punto de Venta (POS)
                    <span class="text-[11px] px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 font-semibold border border-emerald-200">En Línea</span>
                </h1>
                <p class="text-xs text-slate-500">Lectura de códigos de barras, gestión de mostrador y facturación Factus</p>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
            <!-- Selector Bodega -->
            <div class="flex items-center gap-2 bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs">
                <i class="bi bi-building text-slate-400"></i>
                <span class="font-medium text-slate-500">Bodega:</span>
                <select class="bg-transparent font-semibold text-slate-800 focus:outline-none cursor-pointer" @bind="_warehouseId" @bind:after="OnWarehouseChanged">
                    @foreach (var b in _bodegas)
                    {
                        <option value="@b.Id">@b.Name</option>
                    }
                </select>
            </div>

            <!-- Botón Bip Sonoro -->
            <button type="button" class="px-3 py-1.5 rounded-lg border text-xs font-medium transition-colors flex items-center gap-1.5 @(_soundEnabled ? "bg-slate-50 border-slate-200 text-slate-700 hover:bg-slate-100" : "bg-slate-100 border-slate-200 text-slate-400")" @onclick="() => _soundEnabled = !_soundEnabled" title="Activar/Desactivar sonido al escanear">
                <i class="bi @(_soundEnabled ? "bi-volume-up-fill text-blue-600" : "bi-volume-mute-fill")"></i>
                <span>@(_soundEnabled ? "Sonido ON" : "Sonido OFF")</span>
            </button>

            <!-- Atajos rápidos -->
            <div class="hidden xl:flex items-center gap-1.5 text-[11px] text-slate-500 bg-slate-50 px-3 py-1.5 rounded-lg border border-slate-200">
                <span>Atajos:</span>
                <kbd class="font-mono bg-white px-1.5 py-0.5 rounded border border-slate-200 text-slate-700 font-bold">F2</kbd> Lector
                <kbd class="font-mono bg-white px-1.5 py-0.5 rounded border border-slate-200 text-slate-700 font-bold ml-1">F4</kbd> Cliente
                <kbd class="font-mono bg-white px-1.5 py-0.5 rounded border border-slate-200 text-slate-700 font-bold ml-1">F9</kbd> Cobrar
            </div>

            <a href="/ventas" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 bg-slate-50 hover:bg-slate-100 border border-slate-200 transition-colors flex items-center gap-1">
                <i class="bi bi-clock-history"></i> Historial
            </a>
        </div>
    </div>

    @if (_loading)
    {
        <div class="p-12 text-center bg-white rounded-xl border border-slate-200 shadow-xs">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-3 border-blue-600 border-t-transparent mb-3"></div>
            <p class="text-xs font-medium text-slate-600">Cargando catálogo e iniciando terminal de venta...</p>
        </div>
    }
    else
    {
        <!-- Mensajes de Notificación -->
        @if (!string.IsNullOrEmpty(_scanSuccessMessage))
        {
            <div class="p-3 bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs rounded-xl flex items-center justify-between shadow-xs">
                <div class="flex items-center gap-2">
                    <i class="bi bi-check2-circle text-emerald-600 text-base"></i>
                    <span class="font-medium">@_scanSuccessMessage</span>
                </div>
                <button type="button" @onclick="() => _scanSuccessMessage = null" class="text-emerald-500 hover:text-emerald-700 text-base">&times;</button>
            </div>
        }
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="p-3 bg-rose-50 border border-rose-200 text-rose-800 text-xs rounded-xl flex items-center justify-between shadow-xs">
                <div class="flex items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill text-rose-600 text-base"></i>
                    <span class="font-medium">@_error</span>
                </div>
                <button type="button" @onclick="() => _error = null" class="text-rose-500 hover:text-rose-700 text-base">&times;</button>
            </div>
        }

        <!-- Layout POS Dividido: Artículos y Escáner (Izquierda) + Panel de Cobro (Derecha) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-start">
            
            <!-- COLUMNA IZQUIERDA: Disparador de Código de Barras y Carrito de Compras (8 cols) -->
            <div class="lg:col-span-7 xl:col-span-8 space-y-4">
                
                <!-- DISPARADOR / LECTOR DE CÓDIGOS DE BARRAS (CLARO Y PROFESIONAL) -->
                <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-xs space-y-3">
                    <div class="flex items-center justify-between">
                        <label for="barcode-scanner-input" class="text-xs font-bold text-slate-800 uppercase tracking-wider flex items-center gap-2">
                            <i class="bi bi-upc-scan text-blue-600 text-base"></i>
                            <span>Disparador de Código de Barras / SKU / Serial</span>
                        </label>
                        <span class="text-[11px] text-slate-400">
                            Apunta la pistola o escribe y presiona <kbd class="px-1.5 py-0.5 bg-slate-100 border border-slate-300 rounded font-mono text-[10px] text-slate-700">Enter</kbd>
                        </span>
                    </div>

                    <!-- Input Principal de Escaneo -->
                    <div class="flex gap-2">
                        <div class="relative flex-1">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                <i class="bi bi-upc text-lg"></i>
                            </div>
                            <input id="barcode-scanner-input"
                                   type="text"
                                   class="w-full pl-11 pr-10 py-3 bg-slate-50 border-2 border-slate-300 focus:border-blue-600 focus:bg-white rounded-xl text-slate-900 font-mono text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-100 transition-all"
                                   placeholder="Escanear código de barras, SKU o Serial..."
                                   @bind="_barcodeInput"
                                   @bind:event="oninput"
                                   @onkeydown="HandleBarcodeKeyDown"
                                   autocomplete="off" />
                            @if (!string.IsNullOrEmpty(_barcodeInput))
                            {
                                <button type="button" class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600" @onclick="ClearBarcodeInput">
                                    <i class="bi bi-x-circle-fill"></i>
                                </button>
                            }
                        </div>
                        <button type="button" class="px-5 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs transition-colors flex items-center gap-1.5 shadow-xs" @onclick="ProcessBarcodeScan">
                            <i class="bi bi-plus-lg font-bold"></i>
                            <span>Agregar</span>
                        </button>
                    </div>

                    <!-- Filtros Rápidos de Catálogo -->
                    <div class="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-slate-100 text-xs">
                        <div class="flex items-center gap-1.5 overflow-x-auto py-1">
                            <span class="text-slate-400 text-[11px]">Categoría:</span>
                            <button type="button" class="px-2.5 py-1 rounded-lg border text-[11px] font-medium transition-colors @(_selectedCategory == 0 ? "bg-slate-900 border-slate-900 text-white" : "bg-white border-slate-200 text-slate-600 hover:bg-slate-50")" @onclick="() => FilterCategory(0)">Todos</button>
                            @foreach (var cat in _categorias.Take(4))
                            {
                                <button type="button" class="px-2.5 py-1 rounded-lg border text-[11px] font-medium transition-colors @(_selectedCategory == cat.Id ? "bg-slate-900 border-slate-900 text-white" : "bg-white border-slate-200 text-slate-600 hover:bg-slate-50")" @onclick="() => FilterCategory(cat.Id)">@cat.Nombre</button>
                            }
                        </div>
                        <button type="button" class="text-blue-600 hover:text-blue-700 font-semibold text-[11px] flex items-center gap-1" @onclick="() => _showCatalogGrid = !_showCatalogGrid">
                            <i class="bi @(_showCatalogGrid ? "bi-chevron-up" : "bi-grid")"></i>
                            <span>@(_showCatalogGrid ? "Ocultar Catálogo" : "Ver Catálogo")</span>
                        </button>
                    </div>

                    <!-- Catálogo Rápido Desplegable (Blanco y Claro) -->
                    @if (_showCatalogGrid)
                    {
                        <div class="mt-2 max-h-52 overflow-y-auto pr-1 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2 pt-2 border-t border-slate-100">
                            @foreach (var prod in FilteredCatalog)
                            {
                                <button type="button" class="p-2.5 rounded-lg bg-slate-50 hover:bg-slate-100 border border-slate-200 text-left transition-all flex flex-col justify-between group" @onclick="() => AddProductFromCatalog(prod)">
                                    <div>
                                        <div class="text-xs font-semibold text-slate-800 line-clamp-1 group-hover:text-blue-600">@prod.Name</div>
                                        <div class="text-[10px] text-slate-400 font-mono">@prod.Code</div>
                                    </div>
                                    <div class="flex items-center justify-between mt-2 pt-1 border-t border-slate-200/60">
                                        <span class="text-xs font-bold text-slate-900">@prod.PrecioVenta.ToString("C0")</span>
                                        <span class="text-[10px] px-1.5 py-0.2 rounded bg-white border border-slate-200 text-slate-600 font-mono">Stock: @prod.AvailableStock</span>
                                    </div>
                                </button>
                            }
                        </div>
                    }
                </div>

                <!-- TABLA DEL CARRITO (ESTILO FACTURA / RETAIL BLANCO) -->
                <div class="bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden">
                    <div class="p-3.5 bg-slate-50/70 border-b border-slate-200 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <h2 class="font-bold text-slate-800 text-xs uppercase tracking-wider">Artículos en Caja</h2>
                            <span class="px-2 py-0.5 rounded-md bg-white border border-slate-200 text-slate-700 text-xs font-bold font-mono">@_cart.Sum(c => c.Quantity) unidades</span>
                        </div>
                        @if (_cart.Any())
                        {
                            <button type="button" class="text-xs text-rose-600 hover:text-rose-700 font-medium flex items-center gap-1 transition-colors" @onclick="ClearCart">
                                <i class="bi bi-trash"></i> Vaciar Carrito
                            </button>
                        }
                    </div>

                    @if (!_cart.Any())
                    {
                        <div class="p-12 text-center">
                            <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-2">
                                <i class="bi bi-upc-scan text-xl"></i>
                            </div>
                            <h3 class="text-xs font-bold text-slate-700">Esperando lectura de productos</h3>
                            <p class="text-xs text-slate-400 mt-0.5 max-w-sm mx-auto">Dispara el lector de código de barras a cualquier artículo para agregarlo a la cuenta.</p>
                        </div>
                    }
                    else
                    {
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-xs">
                                <thead class="bg-slate-50 text-slate-500 uppercase tracking-wider font-semibold border-b border-slate-200">
                                    <tr>
                                        <th class="py-2.5 px-4">Descripción del Artículo</th>
                                        <th class="py-2.5 px-3 text-center">Cantidad</th>
                                        <th class="py-2.5 px-3 text-right">P. Unitario</th>
                                        <th class="py-2.5 px-2 text-center">IVA</th>
                                        <th class="py-2.5 px-4 text-right">Total</th>
                                        <th class="py-2.5 px-3 text-center"></th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    @foreach (var line in _cart)
                                    {
                                        <tr class="hover:bg-slate-50 transition-colors">
                                            <td class="py-3 px-4">
                                                <div class="font-semibold text-slate-900 text-xs">@line.ProductName</div>
                                                <div class="flex items-center gap-2 text-[11px] text-slate-400 mt-0.5 font-mono">
                                                    <span>@line.ProductCode</span>
                                                    @if (!string.IsNullOrEmpty(line.SerialOrSku))
                                                    {
                                                        <span class="text-blue-700 bg-blue-50 px-1.5 py-0.2 rounded border border-blue-200">SN: @line.SerialOrSku</span>
                                                    }
                                                </div>
                                            </td>
                                            <td class="py-3 px-3 text-center">
                                                <div class="inline-flex items-center border border-slate-300 rounded-lg bg-white overflow-hidden shadow-2xs">
                                                    <button type="button" class="w-7 h-7 flex items-center justify-center text-slate-600 hover:bg-slate-100 font-bold transition-colors" @onclick="() => DecrementLine(line)">-</button>
                                                    <span class="w-8 text-center font-bold text-slate-900 text-xs font-mono">@line.Quantity</span>
                                                    <button type="button" class="w-7 h-7 flex items-center justify-center text-slate-600 hover:bg-slate-100 font-bold transition-colors" @onclick="() => IncrementLine(line)">+</button>
                                                </div>
                                            </td>
                                            <td class="py-3 px-3 text-right font-medium text-slate-700 font-mono">
                                                @line.UnitPrice.ToString("C0")
                                            </td>
                                            <td class="py-3 px-2 text-center">
                                                <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold @(line.TaxRate > 0 ? "bg-slate-100 text-slate-700 border border-slate-200" : "bg-emerald-50 text-emerald-700 border border-emerald-200")">
                                                    @(line.TaxRate > 0 ? $"{(line.TaxRate * 100):0}%" : "0% Exento")
                                                </span>
                                            </td>
                                            <td class="py-3 px-4 text-right font-bold text-slate-900 text-xs font-mono">
                                                @line.LineTotal.ToString("C0")
                                            </td>
                                            <td class="py-3 px-3 text-center">
                                                <button type="button" class="text-slate-400 hover:text-rose-600 p-1 rounded hover:bg-rose-50 transition-colors" @onclick="() => RemoveLine(line)" title="Quitar artículo">
                                                    <i class="bi bi-trash text-sm"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <!-- COLUMNA DERECHA: Totales, Cliente y Formas de Pago (4 cols) -->
            <div class="lg:col-span-5 xl:col-span-4 space-y-4">
                
                <!-- TARJETA CLIENTE -->
                <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-xs space-y-2.5">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-slate-700 uppercase tracking-wider flex items-center gap-1.5">
                            <i class="bi bi-person-circle text-slate-400"></i> Cliente
                        </span>
                        <button type="button" class="text-xs font-semibold text-blue-600 hover:text-blue-700 flex items-center gap-1" @onclick="OpenClientModal">
                            <i class="bi bi-search"></i> Cambiar / Nuevo
                        </button>
                    </div>

                    @if (SelectedClient != null)
                    {
                        <div class="p-3 bg-slate-50 rounded-lg border border-slate-200 flex items-center justify-between gap-2">
                            <div>
                                <div class="font-bold text-slate-900 text-xs">@SelectedClient.Name</div>
                                <div class="text-[11px] text-slate-500 font-mono mt-0.5">
                                    <span>@SelectedClient.DniType.ToString().ToUpper(): @SelectedClient.IdentificationNumber</span>
                                    @if (!string.IsNullOrEmpty(SelectedClient.Email))
                                    {
                                        <span class="text-slate-400 block text-[10px] truncate max-w-[180px]">@SelectedClient.Email</span>
                                    }
                                </div>
                            </div>
                            <button type="button" class="p-1 rounded-md text-slate-400 hover:text-slate-700 hover:bg-slate-200" @onclick="SetDefaultClient" title="Restablecer">
                                <i class="bi bi-x-lg text-xs"></i>
                            </button>
                        </div>
                    }

                    <button type="button" class="w-full py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-[11px] font-semibold transition-colors flex items-center justify-center gap-1.5" @onclick="SetDefaultClient">
                        <i class="bi bi-person-check text-blue-600"></i> 1-Clic: Consumidor Final
                    </button>
                </div>

                <!-- TARJETA TOTALES (TIPO REGISTRADORA POS BLANCA) -->
                <div class="bg-white rounded-xl p-5 border-2 border-slate-200 shadow-xs space-y-3">
                    <div class="space-y-1.5 text-xs text-slate-600 pb-3 border-b border-slate-100">
                        <div class="flex justify-between">
                            <span>Subtotal (Base Gravable):</span>
                            <span class="font-mono font-medium text-slate-800">@CartSubtotal.ToString("C2")</span>
                        </div>
                        <div class="flex justify-between">
                            <span>IVA Total (Factus / DIAN):</span>
                            <span class="font-mono font-medium text-slate-800">+ @CartTax.ToString("C2")</span>
                        </div>
                    </div>

                    <div>
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Total a Pagar</span>
                        <div class="text-3xl font-extrabold text-slate-900 font-mono tracking-tight mt-0.5">
                            @CartTotal.ToString("C2")
                        </div>
                    </div>
                </div>

                <!-- TARJETA MÉTODO DE PAGO Y CAJA -->
                <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-xs space-y-3">
                    <span class="text-xs font-bold text-slate-700 uppercase tracking-wider block">Forma de Pago</span>

                    <!-- Selector Botones de Pago -->
                    <div class="grid grid-cols-3 gap-1.5 text-xs">
                        <button type="button" class="p-2 rounded-lg border text-center font-semibold transition-colors @(_paymentMethod == PaymentMethod.Cash ? "bg-blue-50 border-blue-600 text-blue-700" : "bg-white border-slate-200 text-slate-700 hover:bg-slate-50")" @onclick="() => SetPaymentMethod(PaymentMethod.Cash)">
                            <i class="bi bi-cash d-block text-base mb-0.5"></i> Efectivo
                        </button>
                        <button type="button" class="p-2 rounded-lg border text-center font-semibold transition-colors @(_paymentMethod == PaymentMethod.DebitCard ? "bg-blue-50 border-blue-600 text-blue-700" : "bg-white border-slate-200 text-slate-700 hover:bg-slate-50")" @onclick="() => SetPaymentMethod(PaymentMethod.DebitCard)">
                            <i class="bi bi-credit-card-2-front d-block text-base mb-0.5"></i> Débito
                        </button>
                        <button type="button" class="p-2 rounded-lg border text-center font-semibold transition-colors @(_paymentMethod == PaymentMethod.CreditCard ? "bg-blue-50 border-blue-600 text-blue-700" : "bg-white border-slate-200 text-slate-700 hover:bg-slate-50")" @onclick="() => SetPaymentMethod(PaymentMethod.CreditCard)">
                            <i class="bi bi-credit-card d-block text-base mb-0.5"></i> Crédito
                        </button>
                        <button type="button" class="p-2 rounded-lg border text-center font-semibold transition-colors @(_paymentMethod == PaymentMethod.BankTransfer ? "bg-blue-50 border-blue-600 text-blue-700" : "bg-white border-slate-200 text-slate-700 hover:bg-slate-50")" @onclick="() => SetPaymentMethod(PaymentMethod.BankTransfer)">
                            <i class="bi bi-bank d-block text-base mb-0.5"></i> Transfer.
                        </button>
                        <button type="button" class="p-2 rounded-lg border text-center font-semibold transition-colors @(_paymentMethod == PaymentMethod.Nequi ? "bg-blue-50 border-blue-600 text-blue-700" : "bg-white border-slate-200 text-slate-700 hover:bg-slate-50")" @onclick="() => SetPaymentMethod(PaymentMethod.Nequi)">
                            <i class="bi bi-phone d-block text-base mb-0.5"></i> Nequi
                        </button>
                        <button type="button" class="p-2 rounded-lg border text-center font-semibold transition-colors @(_paymentMethod == PaymentMethod.Credit ? "bg-blue-50 border-blue-600 text-blue-700" : "bg-white border-slate-200 text-slate-700 hover:bg-slate-50")" @onclick="() => SetPaymentMethod(PaymentMethod.Credit)">
                            <i class="bi bi-file-earmark-text d-block text-base mb-0.5"></i> Cartera
                        </button>
                    </div>

                    <!-- Panel de Efectivo y Cambio -->
                    @if (_paymentMethod == PaymentMethod.Cash)
                    {
                        <div class="p-3 bg-slate-50 rounded-lg border border-slate-200 space-y-2 text-xs">
                            <div class="flex items-center justify-between">
                                <span class="font-medium text-slate-600">Dinero Recibido:</span>
                                <div class="flex items-center gap-1">
                                    <span class="text-slate-400 font-mono">$</span>
                                    <input type="number" step="100" class="w-32 py-1 px-2 text-right font-bold text-slate-900 bg-white border border-slate-300 rounded-md focus:outline-none focus:ring-1 focus:ring-blue-600 font-mono" @bind="_paymentAmount" @bind:event="oninput" />
                                </div>
                            </div>

                            <!-- Botones Rápidos de Denominación -->
                            <div class="flex flex-wrap gap-1 pt-1">
                                <button type="button" class="px-2 py-1 bg-white border border-slate-200 hover:bg-slate-100 rounded text-[11px] font-semibold text-slate-700" @onclick="() => _paymentAmount = CartTotal">Exacto</button>
                                <button type="button" class="px-2 py-1 bg-white border border-slate-200 hover:bg-slate-100 rounded text-[11px] font-semibold text-slate-700" @onclick="() => _paymentAmount = 10000">$10.000</button>
                                <button type="button" class="px-2 py-1 bg-white border border-slate-200 hover:bg-slate-100 rounded text-[11px] font-semibold text-slate-700" @onclick="() => _paymentAmount = 20000">$20.000</button>
                                <button type="button" class="px-2 py-1 bg-white border border-slate-200 hover:bg-slate-100 rounded text-[11px] font-semibold text-slate-700" @onclick="() => _paymentAmount = 50000">$50.000</button>
                                <button type="button" class="px-2 py-1 bg-white border border-slate-200 hover:bg-slate-100 rounded text-[11px] font-semibold text-slate-700" @onclick="() => _paymentAmount = 100000">$100.000</button>
                            </div>

                            @if (_paymentAmount > 0 && _cart.Any())
                            {
                                var cambio = _paymentAmount - CartTotal;
                                <div class="pt-2 border-t border-slate-200 flex items-center justify-between font-bold">
                                    <span class="text-slate-600">Cambio / Vueltas:</span>
                                    <span class="@(cambio >= 0 ? "text-emerald-700 font-mono text-sm" : "text-rose-600 font-mono text-sm")">
                                        @(cambio >= 0 ? cambio.ToString("C0") : $"Falta: {Math.Abs(cambio).ToString("C0")}")
                                    </span>
                                </div>
                            }
                        </div>
                    }

                    <!-- BOTÓN DE COBRO SÓLIDO Y LIMPIO -->
                    <button type="button"
                            class="w-full py-3.5 rounded-xl font-bold text-sm text-white bg-emerald-600 hover:bg-emerald-700 shadow-xs transition-colors disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2 mt-2"
                            disabled="@(_saving || !_cart.Any() || _clientId <= 0 || _warehouseId <= 0)"
                            @onclick="ConfirmarVenta">
                        @if (_saving)
                        {
                            <span class="inline-block animate-spin rounded-full h-4 w-4 border-2 border-white border-t-transparent"></span>
                            <span>Procesando venta...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-circle-fill"></i>
                            <span>Cobrar Venta (F9)</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<!-- MODAL BÚSQUEDA Y CREACIÓN RÁPIDA DE CLIENTES -->
@if (_showClientModal)
{
    <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-2xs z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-xl border border-slate-200 max-w-lg w-full overflow-hidden">
            <div class="p-4 border-b border-slate-200 flex items-center justify-between">
                <h3 class="font-bold text-sm text-slate-800 flex items-center gap-2">
                    <i class="bi bi-people text-blue-600"></i> Buscar o Crear Cliente
                </h3>
                <button type="button" class="text-slate-400 hover:text-slate-600 text-lg" @onclick="() => _showClientModal = false">&times;</button>
            </div>

            <div class="p-4 space-y-4">
                <!-- Buscador -->
                <div>
                    <input type="text" class="w-full px-3 py-2 rounded-lg bg-slate-50 border border-slate-300 text-xs focus:outline-none focus:ring-1 focus:ring-blue-600" placeholder="Buscar por nombre, cédula o NIT..." @bind="_clientSearchText" @bind:event="oninput" />
                </div>

                <!-- Lista de resultados -->
                <div class="max-h-44 overflow-y-auto divide-y divide-slate-100 border border-slate-200 rounded-lg">
                    @foreach (var c in FilteredClients)
                    {
                        <div class="p-2.5 hover:bg-slate-50 flex items-center justify-between cursor-pointer transition-colors" @onclick="() => SelectClient(c)">
                            <div>
                                <div class="font-bold text-slate-900 text-xs">@c.Name</div>
                                <div class="text-[11px] text-slate-500 font-mono">@c.DniType.ToString().ToUpper(): @c.IdentificationNumber</div>
                            </div>
                            <span class="text-xs font-semibold text-blue-600">Elegir</span>
                        </div>
                    }
                </div>

                <!-- Formulario Nuevo Cliente -->
                <div class="pt-3 border-t border-slate-100">
                    <span class="text-xs font-bold text-slate-700 block mb-2">Crear nuevo cliente rápido:</span>
                    <div class="grid grid-cols-2 gap-2 text-xs">
                        <div class="col-span-2">
                            <input type="text" class="w-full p-2 bg-slate-50 border border-slate-300 rounded-lg" placeholder="Nombre completo *" @bind="_newClientName" />
                        </div>
                        <div>
                            <select class="w-full p-2 bg-slate-50 border border-slate-300 rounded-lg text-xs" @bind="_newClientDniType">
                                @foreach (var t in Enum.GetValues<DniType>())
                                {
                                    <option value="@t">@t</option>
                                }
                            </select>
                        </div>
                        <div>
                            <input type="text" class="w-full p-2 bg-slate-50 border border-slate-300 rounded-lg" placeholder="Documento / NIT *" @bind="_newClientDoc" />
                        </div>
                        <div>
                            <input type="email" class="w-full p-2 bg-slate-50 border border-slate-300 rounded-lg" placeholder="Email Facturación" @bind="_newClientEmail" />
                        </div>
                        <div>
                            <input type="text" class="w-full p-2 bg-slate-50 border border-slate-300 rounded-lg" placeholder="Teléfono" @bind="_newClientPhone" />
                        </div>
                    </div>
                    <button type="button" class="w-full mt-3 py-2 bg-slate-900 hover:bg-slate-800 text-white font-semibold text-xs rounded-lg transition-colors" @onclick="CreateAndSelectClient">
                        Guardar y Seleccionar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL TICKET TÉRMICO IMPRIMIBLE (80MM BLANCO) -->
@if (_showReceiptModal && _completedSale != null)
{
    <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-2xs z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-xl border border-slate-200 max-w-sm w-full overflow-hidden">
            <div class="p-3.5 border-b border-slate-200 flex items-center justify-between">
                <h3 class="font-bold text-xs text-slate-800 flex items-center gap-1.5">
                    <i class="bi bi-receipt text-slate-500"></i> Comprobante de Venta
                </h3>
                <button type="button" class="text-slate-400 hover:text-slate-600 text-lg" @onclick="CloseReceiptModal">&times;</button>
            </div>

            <!-- Ticket Térmico -->
            <div class="p-5 max-h-[65vh] overflow-y-auto text-xs bg-white text-slate-900 font-sans" id="pos-receipt-print-area">
                <div class="text-center space-y-0.5 pb-3 border-b border-dashed border-slate-300">
                    <h2 class="text-sm font-black text-slate-900 uppercase">ERP DATASET</h2>
                    <p class="text-[10px] text-slate-500 font-mono">NIT: 900.123.456-7</p>
                    <p class="text-[10px] text-slate-500">Bodega: @_completedSale.WarehouseName</p>
                    <div class="font-mono font-bold text-xs text-slate-800 mt-1">
                        @_completedSale.SaleNumber
                    </div>
                    <div class="text-[10px] text-slate-400">@_completedSale.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                </div>

                <!-- Cliente -->
                <div class="py-2 border-b border-dashed border-slate-300 text-[11px] space-y-0.5">
                    <div class="flex justify-between">
                        <span class="text-slate-500">Cliente:</span>
                        <span class="font-bold text-slate-900">@_completedSale.ClientName</span>
                    </div>
                    <div class="flex justify-between font-mono">
                        <span class="text-slate-500">Documento:</span>
                        <span>@_completedSale.ClientIdentification</span>
                    </div>
                </div>

                <!-- Artículos -->
                <div class="py-2 border-b border-dashed border-slate-300 space-y-1.5">
                    <table class="w-full text-left">
                        <thead>
                            <tr class="text-[10px] text-slate-400 uppercase">
                                <th>Cant. &bull; Detalle</th>
                                <th class="text-right">Total</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var l in _completedSale.Lines)
                            {
                                <tr>
                                    <td class="py-1 pr-2">
                                        <div class="font-medium text-slate-800">@l.ProductName</div>
                                        <div class="text-[10px] text-slate-400 font-mono">@l.Quantity x @l.UnitPrice.ToString("C0")</div>
                                    </td>
                                    <td class="py-1 text-right font-bold text-slate-900 align-top font-mono">
                                        @l.LineTotal.ToString("C0")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Totales -->
                <div class="py-2 border-b border-dashed border-slate-300 space-y-1 font-mono text-[11px]">
                    <div class="flex justify-between text-slate-500">
                        <span>Subtotal:</span>
                        <span>@_completedSale.Subtotal.ToString("C2")</span>
                    </div>
                    <div class="flex justify-between text-slate-500">
                        <span>IVA Total:</span>
                        <span>@_completedSale.TaxAmount.ToString("C2")</span>
                    </div>
                    <div class="flex justify-between text-xs font-bold text-slate-900 pt-1 border-t border-slate-200">
                        <span>TOTAL:</span>
                        <span>@_completedSale.Total.ToString("C2")</span>
                    </div>
                </div>

                <!-- DIAN / Factus Ready -->
                <div class="pt-3 text-center text-[10px] text-slate-400">
                    <p class="font-semibold text-slate-600">Factura Electrónica (Factus / DIAN)</p>
                    <p class="font-mono text-[9px] break-all">CUFE: @_completedSale.SaleNumber-DIAN-AUTORIZADO</p>
                    <p class="mt-1 text-slate-500">¡Gracias por su compra!</p>
                </div>
            </div>

            <!-- Botones Modal -->
            <div class="p-3 bg-slate-50 border-t border-slate-200 flex gap-2">
                <button type="button" class="flex-1 py-2 bg-white border border-slate-300 hover:bg-slate-100 text-slate-700 font-semibold text-xs rounded-lg transition-colors flex items-center justify-center gap-1.5" @onclick="PrintReceipt">
                    <i class="bi bi-printer"></i> Imprimir
                </button>
                <button type="button" class="flex-1 py-2 bg-slate-900 hover:bg-slate-800 text-white font-semibold text-xs rounded-lg transition-colors flex items-center justify-center gap-1.5" @onclick="CloseReceiptModal">
                    <i class="bi bi-plus-lg"></i> Nueva Venta
                </button>
            </div>
        </div>
    </div>
}
