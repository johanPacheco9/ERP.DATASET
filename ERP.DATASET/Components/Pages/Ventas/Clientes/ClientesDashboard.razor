@page "/clientes"
@rendermode InteractiveServer

<div class="max-w-[1600px] mx-auto p-2 sm:p-4 space-y-6">
    <!-- Header Clientes -->
    <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <span class="px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-semibold text-xs border border-emerald-200">
                    Facturación & POS
                </span>
            </div>
            <h1 class="text-2xl font-bold text-slate-800 tracking-tight">Directorio de Clientes</h1>
            <p class="text-xs text-slate-500 mt-0.5">Gestión de datos fiscales para facturación electrónica (Factus / DIAN)</p>
        </div>

        <div class="flex items-center gap-3">
            <a href="/ventas/nueva" class="px-3.5 py-2 rounded-xl text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 transition-colors flex items-center gap-1.5 border border-slate-200">
                <i class="bi bi-cart3"></i> Ir a POS
            </a>
            <a href="/clientes/nuevo" class="px-4 py-2.5 rounded-xl text-sm font-bold text-slate-950 bg-gradient-to-r from-emerald-400 via-emerald-500 to-teal-400 hover:from-emerald-300 hover:to-teal-300 shadow-md shadow-emerald-500/20 transition-all flex items-center gap-2 transform active:scale-95">
                <i class="bi bi-person-plus-fill text-base"></i> Nuevo Cliente
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="p-4 bg-rose-50 border border-rose-200 text-rose-800 rounded-xl text-sm flex items-center gap-3">
            <i class="bi bi-exclamation-octagon-fill text-rose-600 text-lg"></i>
            <span>@_error</span>
        </div>
    }

    <!-- Barra de Búsqueda -->
    <div class="bg-white rounded-2xl p-4 shadow-sm border border-slate-200">
        <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                <i class="bi bi-search"></i>
            </div>
            <input type="text"
                   class="w-full pl-10 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
                   placeholder="Buscar cliente por nombre, NIT, cédula, email o teléfono..."
                   @bind="_search"
                   @bind:event="oninput"
                   @bind:after="FilterClients" />
        </div>
    </div>

    @if (_loading)
    {
        <div class="p-12 text-center bg-white rounded-2xl border border-slate-200 shadow-sm">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-emerald-500 border-t-transparent mb-3"></div>
            <p class="text-sm font-medium text-slate-600">Cargando directorio de clientes...</p>
        </div>
    }
    else if (!_items.Any())
    {
        <div class="bg-white rounded-2xl p-12 text-center border border-slate-200 shadow-sm">
            <div class="w-16 h-16 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-3">
                <i class="bi bi-person-x text-2xl"></i>
            </div>
            <h3 class="text-base font-bold text-slate-800">No se encontraron clientes</h3>
            <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">Registre los clientes para poder emitir facturas con sus datos fiscales.</p>
            <div class="mt-4">
                <a href="/clientes/nuevo" class="px-4 py-2 rounded-xl text-xs font-bold text-slate-950 bg-emerald-400 hover:bg-emerald-300 shadow transition-colors inline-flex items-center gap-1.5">
                    <i class="bi bi-plus-lg"></i> Registrar Cliente
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-slate-50 text-slate-500 uppercase tracking-wider font-semibold border-b border-slate-200">
                        <tr>
                            <th class="py-3.5 px-4">Nombre / Razón Social</th>
                            <th class="py-3.5 px-4">Tipo & Documento</th>
                            <th class="py-3.5 px-4">Email (Factus)</th>
                            <th class="py-3.5 px-4">Teléfono</th>
                            <th class="py-3.5 px-4">Ciudad / Dirección</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var c in _items)
                        {
                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <td class="py-3 px-4 font-semibold text-slate-900 text-sm">
                                    @c.Name
                                </td>
                                <td class="py-3 px-4 font-mono">
                                    <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-700 font-semibold uppercase text-[10px] me-1">
                                        @c.DniType
                                    </span>
                                    <span class="text-slate-800 font-bold">@c.IdentificationNumber</span>
                                    @if (!string.IsNullOrEmpty(c.Dv))
                                    {
                                        <span class="text-slate-400">-@c.Dv</span>
                                    }
                                </td>
                                <td class="py-3 px-4 text-slate-600 font-mono">
                                    @(c.Email ?? "—")
                                </td>
                                <td class="py-3 px-4 text-slate-600">
                                    @(c.PhoneNumber ?? "—")
                                </td>
                                <td class="py-3 px-4 text-slate-500">
                                    @c.City @(string.IsNullOrEmpty(c.Address) ? "" : $"• {c.Address}")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
