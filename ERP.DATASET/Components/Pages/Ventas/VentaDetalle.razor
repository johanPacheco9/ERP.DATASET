@page "/ventas/{Id:int}"
@using ERP.TRAN.CrossLayers.API.Pos.Payments.Enums
@rendermode InteractiveServer

<div class="container-fluid py-4 bg-light min-vh-100">
    @if (_loading)
    {
        <div class="d-flex justify-content-center align-items-center position-fixed start-0 top-0 w-100 h-100 bg-white bg-opacity-75" style="z-index: 1050;">
            <div class="text-center">
                <div class="spinner-border text-primary mb-2" role="status"></div>
                <div class="text-muted small fw-medium">Cargando transacción...</div>
            </div>
        </div>
    }
    else if (_venta == null)
    {
        <div class="alert alert-warning shadow-sm d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-4"></i>
            <div>
                <h6 class="alert-heading mb-0 fw-bold">Venta no encontrada</h6>
                <small>El identificador de la venta no corresponde a ningún registro activo.</small>
            </div>
            <a href="/ventas" class="btn btn-warning btn-sm ms-auto">Volver al listado</a>
        </div>
    }
    else
    {
        @* ENCABEZADO DE ACCIÓN REFINADO *@
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge bg-dark-subtle text-dark border px-2 py-1 font-monospace">@_venta.SaleNumber</span>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                        <i class="bi bi-check-circle-fill me-1"></i> @_venta.StatusDisplay
                    </span>
                </div>
                <h3 class="fw-bold tracking-tight mb-0">@_venta.ClientName</h3>
                <small class="text-muted"><i class="bi bi-geo-alt me-1"></i>Punto de Despacho: <strong>@_venta.WarehouseName</strong></small>
            </div>
            <a href="/ventas" class="btn btn-white btn-sm border shadow-sm px-3">
                <i class="bi bi-arrow-left me-1"></i> Volver a Ventas
            </a>
        </div>

        @* LAYOUT ASIMÉTRICO DE DOS COLUMNAS *@
        <div class="row g-4">
            
            @* COLUMNA PRINCIPAL (IZQUIERDA): PRODUCTOS Y LOGÍSTICA *@
            <div class="col-lg-8">
                
                @* Banner Logístico de Inventario (Discreto y corporativo) *@
                <div class="p-3 bg-white border rounded shadow-sm d-flex align-items-start gap-3 mb-4">
                    <div class="p-2 bg-primary-subtle text-primary rounded">
                        <i class="bi bi-box-seam fs-5"></i>
                    </div>
                    <div>
                        <span class="fw-bold d-block text-dark small mb-0">Trazabilidad de Inventario</span>
                        <small class="text-muted">
                            Cada ítem generó un movimiento de salida de tipo <span class="badge bg-light text-dark border font-monospace">venta</span>. 
                            Las unidades físicas pasaron al estado <span class="text-dark fw-medium">Vendido</span> de manera inmediata.
                        </small>
                    </div>
                </div>

                @* Tabla de Detalles de Ítems *@
                <div class="card shadow-sm border-0 overflow-hidden">
                    <div class="card-header bg-white border-bottom py-3">
                        <h6 class="mb-0 fw-bold text-secondary">Artículos Despachados (@_venta.Lines.Count)</h6>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-uppercase fs-7 tracking-wider border-bottom text-muted">
                                <tr>
                                    <th scope="col" class="ps-4">Producto</th>
                                    <th scope="col">Serial / SKU</th>
                                    <th scope="col" class="text-center">Cant.</th>
                                    <th scope="col" class="text-end">Precio Unitario</th>
                                    <th scope="col" class="text-end">Subtotal</th>
                                    <th scope="col" class="text-end pe-4">Mov. Inv</th>
                                </tr>
                            </thead>
                            <tbody class="border-top-0">
                                @foreach (var l in _venta.Lines)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <span class="fw-semibold text-dark d-block">@l.ProductName</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-secondary border font-monospace small">@(l.SerialOrSku ?? "—")</span>
                                        </td>
                                        <td class="text-center fw-medium">@l.Quantity</td>
                                        <td class="text-end text-muted">@l.UnitPrice.ToString("C2")</td>
                                        <td class="text-end fw-semibold text-dark">@l.LineTotal.ToString("C2")</td>
                                        <td class="text-end pe-4">
                                            <span class="text-muted font-monospace small">#@(l.MovementId?.ToString() ?? "—")</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            @* COLUMNA FINANCIERA (DERECHA): ESTADO DE PAGO Y AUDITORÍA *@
            <div class="col-lg-4">
                @if (_pagos != null)
                {
                    @* Alerta Crítica de Cartera / Saldos Pendientes *@
                    @if (_pagos.Balance > 0)
                    {
                        <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center p-3 mb-4 animate-pulse">
                            <i class="bi bi-exclamation-octagon-fill text-danger fs-3 me-3"></i>
                            <div>
                                <h6 class="mb-0 fw-bold text-danger">Venta con Saldo Pendiente</h6>
                                <p class="mb-0 text-dark small">El cliente tiene una deuda de <strong>@_pagos.Balance.ToString("C2")</strong> sobre esta factura.</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success border-0 shadow-sm d-flex align-items-center p-3 mb-4">
                            <i class="bi bi-shield-check text-success fs-3 me-3"></i>
                            <div>
                                <h6 class="mb-0 fw-bold text-success">Transacción Liquidada</h6>
                                <p class="mb-0 text-muted small">No se registran saldos pendientes para esta venta.</p>
                            </div>
                        </div>
                    }

                    @* Tarjeta Resumen de Caja (Kpi Financiero con fix de desborde) *@
                    <div class="card shadow-sm border-0 mb-4 bg-dark text-white overflow-hidden">
                        @* Añadimos un min-height para asegurar que el contenido no se comprima *@
                        <div class="card-body p-4 position-relative" style="min-height: 180px;">
        
                            @* FIX: Cambiamos inline el estilo del signo para que quede perfectamente al borde y no pise las cifras *@
                            <div class="position-absolute end-0 bottom-0 p-2" style="opacity: 0.06; line-height: 1; pointer-events: none;">
                                <i class="bi bi-currency-dollar" style="font-size: 7.5rem;"></i>
                            </div>
        
                            <div class="position-relative" style="z-index: 2;">
                                <span class="text-muted-white text-uppercase fs-7 tracking-wider fw-medium d-block mb-1">Estado de Cartera</span>
                                <h5 class="fw-bold mb-3">@_pagos.PaymentStatus</h5>
            
                                <hr class="border-secondary my-3" />
            
                                <div class="d-flex justify-content-between mb-2 small text-light opacity-75">
                                    <span>Total Facturado:</span>
                                    <span class="fw-medium">@_pagos.SaleTotal.ToString("C2")</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2 text-success fw-medium">
                                    <span>Total Recaudado:</span>
                                    <span>+ @_pagos.TotalPaid.ToString("C2")</span>
                                </div>
                                <div class="d-flex justify-content-between pt-2 border-top border-secondary align-items-baseline">
                                    <span class="fw-bold fs-7 text-uppercase tracking-wider opacity-75">Saldo Deudor:</span>
                                    <span class="fs-4 fw-bold text-warning">
                                        @_pagos.Balance.ToString("C2")
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Historial de Transacciones de Caja *@
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                            <h6 class="mb-0 fw-bold text-secondary">Historial de Recaudos</h6>
                            <div class="d-flex align-items-center gap-2">
                                @if (_pagos.Balance > 0)
                                {
                                    <button class="btn btn-sm btn-primary" @onclick="OpenPaymentModal">
                                        <i class="bi bi-cash-coin me-1"></i>Registrar abono
                                    </button>
                                }
                                <span class="badge bg-light text-muted border font-monospace">@_pagos.Payments.Count()</span>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            @if (!_pagos.Payments.Any())
                            {
                                <div class="text-center py-4 text-muted">
                                    <i class="bi bi-wallet2 fs-2 d-block mb-2 text-black-50"></i>
                                    <small>No se registran transacciones de ingreso.</small>
                                </div>
                            }
                            else
                            {
                                <div class="list-group list-group-flush small">
                                    @foreach (var p in _pagos.Payments)
                                    {
                                        <div class="list-group-item p-3 border-bottom-dashed">
                                            <div class="d-flex justify-content-between align-items-start mb-1">
                                                <span class="fw-bold text-dark"><i class="bi bi-credit-card-2-back me-1 text-muted"></i> @p.Method</span>
                                                <span class="fw-bold text-success">+ @p.Amount.ToString("C2")</span>
                                            </div>
                                            <div class="d-flex justify-content-between text-muted fs-7">
                                                <span>@p.PaidAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</span>
                                                <span>Ref: <strong class="text-dark">@(p.Reference ?? "N/A")</strong></span>
                                            </div>
                                            <div class="mt-2 pt-1 border-top border-light text-end fs-7 text-black-50">
                                                <i class="bi bi-person-circle"></i> Cajero: @p.CreatedBy
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@if (_showPaymentModal && _pagos != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white">
                    <h6 class="modal-title fw-bold">Registrar Abono</h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showPaymentModal = false"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="alert alert-info small">
                        Saldo pendiente: <strong>@_pagos.Balance.ToString("C2")</strong>
                    </div>
                    @if (!string.IsNullOrEmpty(_paymentError))
                    {
                        <div class="alert alert-danger small">@_paymentError</div>
                    }
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Valor</label>
                            <InputNumber class="form-control" @bind-Value="_paymentForm.Amount" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Fecha</label>
                            <InputDate class="form-control" @bind-Value="_paymentForm.PaidAt" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Metodo</label>
                            <InputSelect class="form-select" @bind-Value="_paymentForm.Method">
                                <option value="@PaymentMethod.Cash">Efectivo</option>
                                <option value="@PaymentMethod.CreditCard">Tarjeta credito</option>
                                <option value="@PaymentMethod.DebitCard">Tarjeta debito</option>
                                <option value="@PaymentMethod.BankTransfer">Transferencia</option>
                                <option value="@PaymentMethod.Nequi">Nequi</option>
                                <option value="@PaymentMethod.Credit">Credito</option>
                            </InputSelect>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Referencia</label>
                            <InputText class="form-control" @bind-Value="_paymentForm.Reference" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Notas</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="_paymentForm.Notes" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light p-2">
                    <button type="button" class="btn btn-white btn-sm border" @onclick="() => _showPaymentModal = false">Cancelar</button>
                    <button type="button" class="btn btn-primary btn-sm px-3" @onclick="SavePayment" disabled="@_savingPayment">
                        @if (_savingPayment)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Guardar abono
                    </button>
                </div>
            </div>
        </div>
    </div>
}
