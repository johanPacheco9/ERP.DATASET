@page "/ventas/{Id:int}"
@using ERP.TRAN.CrossLayers.API.Pos.Payments.Enums
@rendermode InteractiveServer

<div class="max-w-[1600px] mx-auto space-y-5">
    @if (_loading)
    {
        <div class="p-12 text-center bg-white rounded-xl border border-slate-200 shadow-xs">
            <div class="inline-block animate-spin rounded-full h-7 w-7 border-3 border-blue-600 border-t-transparent mb-2"></div>
            <p class="text-xs font-medium text-slate-600">Cargando comprobante de venta...</p>
        </div>
    }
    else if (_venta == null)
    {
        <div class="p-4 bg-amber-50 border border-amber-200 rounded-xl text-amber-900 flex items-center justify-between text-xs">
            <div class="flex items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill text-amber-600 text-lg"></i>
                <span class="font-semibold">Venta no encontrada.</span>
            </div>
            <a href="/ventas" class="px-3 py-1.5 bg-amber-600 text-white font-semibold rounded-lg hover:bg-amber-700">Volver</a>
        </div>
    }
    else
    {
        <!-- Header Venta Blanco -->
        <div class="bg-white rounded-xl p-4 sm:p-5 border border-slate-200 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span class="px-2 py-0.5 rounded-md bg-slate-900 text-white font-mono font-bold text-xs">
                        @_venta.SaleNumber
                    </span>
                    <span class="px-2 py-0.5 rounded-md text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                        @_venta.StatusDisplay
                    </span>
                    <span class="px-2 py-0.5 rounded-md text-[11px] font-semibold bg-blue-50 text-blue-700 border border-blue-200">
                        Factus: @(_venta.FactusStatus ?? "Pendiente DIAN")
                    </span>
                </div>
                <h1 class="text-lg font-bold text-slate-900 tracking-tight">@_venta.ClientName</h1>
                <div class="flex items-center gap-2 text-xs text-slate-500 mt-0.5 font-mono">
                    <span>Doc: @_venta.ClientIdentification</span>
                    <span>&bull;</span>
                    <span>Bodega: @_venta.WarehouseName</span>
                    <span>&bull;</span>
                    <span>@_venta.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            </div>

            <div class="flex items-center gap-2">
                <button type="button" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-700 bg-white hover:bg-slate-50 border border-slate-200 transition-colors flex items-center gap-1.5 shadow-2xs" @onclick="PrintInvoice">
                    <i class="bi bi-printer text-slate-500"></i> Imprimir Factura
                </button>
                <a href="/ventas" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 bg-slate-50 hover:bg-slate-100 border border-slate-200 transition-colors flex items-center gap-1">
                    <i class="bi bi-arrow-left"></i> Historial
                </a>
            </div>
        </div>

        <!-- Grid 2 Columnas -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
            
            <!-- Columna Izquierda: Artículos (8 cols) -->
            <div class="lg:col-span-8 space-y-4">
                
                <!-- Banner Factus DIAN Blanco -->
                <div class="bg-white rounded-xl p-3.5 border border-slate-200 shadow-xs flex items-center justify-between gap-3 text-xs">
                    <div class="flex items-center gap-2.5">
                        <i class="bi bi-shield-check text-emerald-600 text-xl"></i>
                        <div>
                            <span class="font-bold text-slate-800 block">Facturación Electrónica DIAN</span>
                            <span class="text-slate-500">Estructura impositiva lista para sincronización con la API de Factus.</span>
                        </div>
                    </div>
                    <button type="button" class="px-3 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs shadow-2xs transition-colors" @onclick="EmitirFactusSimulado">
                        <i class="bi bi-send me-1"></i> Emitir a Factus
                    </button>
                </div>

                <!-- Tabla de Artículos -->
                <div class="bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden">
                    <div class="p-3.5 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
                        <h2 class="font-bold text-xs uppercase tracking-wider text-slate-700">Artículos Facturados (@_venta.Lines.Count)</h2>
                        <span class="text-slate-400 text-xs font-mono">Trazabilidad de inventario</span>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs">
                            <thead class="bg-slate-50 text-slate-500 uppercase tracking-wider font-semibold border-b border-slate-200">
                                <tr>
                                    <th class="py-2.5 px-4">Producto</th>
                                    <th class="py-2.5 px-3">Serial / SKU</th>
                                    <th class="py-2.5 px-3 text-center">Cant.</th>
                                    <th class="py-2.5 px-3 text-right">P. Unitario</th>
                                    <th class="py-2.5 px-2 text-center">IVA</th>
                                    <th class="py-2.5 px-4 text-right">Total</th>
                                    <th class="py-2.5 px-3 text-right">Movimiento</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @foreach (var l in _venta.Lines)
                                {
                                    <tr class="hover:bg-slate-50 transition-colors">
                                        <td class="py-2.5 px-4 font-semibold text-slate-900">
                                            @l.ProductName
                                        </td>
                                        <td class="py-2.5 px-3 font-mono text-slate-500">
                                            @(l.SerialNumber ?? "—")
                                        </td>
                                        <td class="py-2.5 px-3 text-center font-bold text-slate-800">
                                            @l.Quantity
                                        </td>
                                        <td class="py-2.5 px-3 text-right font-mono text-slate-600">
                                            @l.UnitPrice.ToString("C0")
                                        </td>
                                        <td class="py-2.5 px-2 text-center">
                                            <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold @(l.TaxRate > 0 ? "bg-slate-100 text-slate-700 border border-slate-200" : "bg-emerald-50 text-emerald-700 border border-emerald-200")">
                                                @(l.TaxRate > 0 ? $"{(l.TaxRate * 100):0}%" : "Exento")
                                            </span>
                                        </td>
                                        <td class="py-2.5 px-4 text-right font-mono font-bold text-slate-900">
                                            @l.LineTotal.ToString("C0")
                                        </td>
                                        <td class="py-2.5 px-3 text-right font-mono text-slate-400">
                                            #@(l.MovementId?.ToString() ?? "—")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_venta.Notes))
                {
                    <div class="p-3.5 bg-white rounded-xl border border-slate-200 text-xs">
                        <span class="font-bold text-slate-700 block mb-0.5">Observaciones:</span>
                        <p class="text-slate-600">@_venta.Notes</p>
                    </div>
                }
            </div>

            <!-- Columna Derecha: Estado de Cartera y Abonos (4 cols) -->
            <div class="lg:col-span-4 space-y-4">
                
                <!-- Tarjeta Resumen Financiero Blanco -->
                <div class="bg-white rounded-xl p-4 border-2 border-slate-200 shadow-xs space-y-3">
                    <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Estado de Cartera</span>
                    <h3 class="text-base font-bold text-slate-900">@(_pagos?.PaymentStatus ?? _venta.PaymentStatus.ToString())</h3>

                    <div class="space-y-1.5 text-xs border-t border-slate-100 pt-2.5 font-mono">
                        <div class="flex justify-between text-slate-600">
                            <span>Subtotal:</span>
                            <span class="text-slate-800 font-semibold">@_venta.Subtotal.ToString("C2")</span>
                        </div>
                        <div class="flex justify-between text-slate-600">
                            <span>IVA Total:</span>
                            <span class="text-slate-800 font-semibold">+ @_venta.TaxAmount.ToString("C2")</span>
                        </div>
                        <div class="flex justify-between text-slate-900 font-bold pt-1 border-t border-slate-100">
                            <span>Total Facturado:</span>
                            <span>@_venta.Total.ToString("C2")</span>
                        </div>
                        <div class="flex justify-between text-emerald-700 font-bold">
                            <span>Total Recaudado:</span>
                            <span>+ @((_pagos?.TotalPaid ?? _venta.Total).ToString("C2"))</span>
                        </div>
                        <div class="flex justify-between font-bold text-sm pt-2 border-t border-slate-100 @((_pagos?.Balance ?? 0) > 0 ? "text-rose-600" : "text-slate-500")">
                            <span>Saldo Pendiente:</span>
                            <span>@((_pagos?.Balance ?? 0).ToString("C2"))</span>
                        </div>
                    </div>
                </div>

                <!-- Historial de Pagos / Abonos -->
                <div class="bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden">
                    <div class="p-3.5 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
                        <h3 class="font-bold text-xs uppercase tracking-wider text-slate-700">Historial de Recaudos</h3>
                        @if (_pagos != null && _pagos.Balance > 0)
                        {
                            <button type="button" class="px-2.5 py-1 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs transition-colors flex items-center gap-1" @onclick="OpenPaymentModal">
                                <i class="bi bi-plus-lg"></i> Registrar Abono
                            </button>
                        }
                    </div>

                    <div class="p-3.5">
                        @if (_pagos == null || !_pagos.Payments.Any())
                        {
                            <div class="text-center py-5 text-slate-400 text-xs">
                                <i class="bi bi-wallet2 text-xl d-block mb-1"></i>
                                <span>No hay abonos registrados.</span>
                            </div>
                        }
                        else
                        {
                            <div class="divide-y divide-slate-100 text-xs space-y-2">
                                @foreach (var p in _pagos.Payments)
                                {
                                    <div class="pt-2 first:pt-0">
                                        <div class="flex justify-between items-center font-semibold">
                                            <span class="text-slate-800"><i class="bi bi-credit-card text-slate-400 me-1"></i> @p.Method</span>
                                            <span class="text-emerald-700 font-mono">+ @p.Amount.ToString("C0")</span>
                                        </div>
                                        <div class="flex justify-between text-[11px] text-slate-400 font-mono mt-0.5">
                                            <span>@p.PaidAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                            <span>Ref: @(p.Reference ?? "N/A")</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- MODAL REGISTRAR ABONO -->
@if (_showPaymentModal && _pagos != null)
{
    <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-2xs z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-xl border border-slate-200 max-w-md w-full overflow-hidden">
            <div class="p-4 border-b border-slate-200 flex items-center justify-between">
                <h3 class="font-bold text-sm text-slate-800 flex items-center gap-2">
                    <i class="bi bi-cash-coin text-blue-600"></i> Registrar Abono a Factura
                </h3>
                <button type="button" class="text-slate-400 hover:text-slate-600 text-lg" @onclick="() => _showPaymentModal = false">&times;</button>
            </div>

            <div class="p-4 space-y-3.5 text-xs">
                <div class="p-2.5 bg-amber-50 border border-amber-200 rounded-lg flex items-center justify-between text-amber-900 font-bold">
                    <span>Saldo pendiente:</span>
                    <span class="font-mono text-sm">@_pagos.Balance.ToString("C2")</span>
                </div>

                @if (!string.IsNullOrEmpty(_paymentError))
                {
                    <div class="p-2.5 bg-rose-50 border border-rose-200 rounded-lg text-rose-800">
                        @_paymentError
                    </div>
                }

                <div class="space-y-2.5">
                    <div>
                        <label class="font-semibold text-slate-700 block mb-1">Monto del Abono *</label>
                        <input type="number" class="w-full p-2 bg-slate-50 border border-slate-300 rounded-lg font-bold font-mono text-slate-900 text-xs focus:outline-none focus:ring-1 focus:ring-blue-600" @bind="_paymentForm.Amount" />
                    </div>

                    <div>
                        <label class="font-semibold text-slate-700 block mb-1">Método de Pago</label>
                        <select class="w-full p-2 bg-slate-50 border border-slate-300 rounded-lg text-xs" @bind="_paymentForm.Method">
                            <option value="@PaymentMethod.Cash">Efectivo</option>
                            <option value="@PaymentMethod.DebitCard">Tarjeta Débito</option>
                            <option value="@PaymentMethod.CreditCard">Tarjeta Crédito</option>
                            <option value="@PaymentMethod.BankTransfer">Transferencia Bancaria</option>
                            <option value="@PaymentMethod.Nequi">Nequi</option>
                            <option value="@PaymentMethod.Credit">Crédito</option>
                        </select>
                    </div>

                    <div>
                        <label class="font-semibold text-slate-700 block mb-1">Referencia / Comprobante</label>
                        <input type="text" class="w-full p-2 bg-slate-50 border border-slate-300 rounded-lg text-xs" placeholder="Ej: TRX-998822" @bind="_paymentForm.Reference" />
                    </div>

                    <div>
                        <label class="font-semibold text-slate-700 block mb-1">Notas</label>
                        <textarea class="w-full p-2 bg-slate-50 border border-slate-300 rounded-lg text-xs" rows="2" placeholder="Observaciones..." @bind="_paymentForm.Notes"></textarea>
                    </div>
                </div>

                <div class="pt-2 flex gap-2">
                    <button type="button" class="flex-1 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold rounded-lg transition-colors" @onclick="() => _showPaymentModal = false">
                        Cancelar
                    </button>
                    <button type="button" class="flex-1 py-2 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg shadow-xs transition-colors flex items-center justify-center gap-1" @onclick="SavePayment" disabled="@_savingPayment">
                        @if (_savingPayment)
                        {
                            <span class="inline-block animate-spin rounded-full h-3 w-3 border-2 border-white border-t-transparent"></span>
                        }
                        <span>Guardar Abono</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}
