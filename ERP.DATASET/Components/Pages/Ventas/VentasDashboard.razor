@page "/ventas"
@rendermode InteractiveServer

<div class="max-w-[1600px] mx-auto space-y-5">
    <!-- Header Ventas Blanco & Corporativo -->
    <div class="bg-white rounded-xl p-4 sm:p-5 border border-slate-200 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <span class="px-2 py-0.5 rounded-md bg-blue-50 text-blue-700 font-semibold text-[11px] border border-blue-200">
                    Ventas & Facturación
                </span>
            </div>
            <h1 class="text-xl font-bold text-slate-900 tracking-tight">Historial de Ventas</h1>
            <p class="text-xs text-slate-500 mt-0.5">Control de ingresos, salidas de inventario y estado de facturación Factus / DIAN</p>
        </div>

        <div class="flex items-center gap-2.5">
            <a href="/cartera" class="px-3.5 py-2 rounded-lg text-xs font-semibold text-slate-700 bg-white hover:bg-slate-50 border border-slate-200 transition-colors flex items-center gap-1.5 shadow-2xs">
                <i class="bi bi-cash-stack text-slate-500"></i> Cartera
            </a>
            <a href="/ventas/nueva" class="px-4 py-2 rounded-lg text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 shadow-xs transition-colors flex items-center gap-1.5">
                <i class="bi bi-cart-plus-fill"></i> Nueva Venta (POS)
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="p-3 bg-rose-50 border border-rose-200 text-rose-800 rounded-lg text-xs flex items-center gap-2">
            <i class="bi bi-exclamation-octagon-fill text-rose-600 text-sm"></i>
            <span>@_error</span>
        </div>
    }

    <!-- KPI Metric Cards Blancas & Claras -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
        <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-xs flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-lg bg-slate-100 text-slate-700 flex items-center justify-center text-lg">
                <i class="bi bi-bag-check"></i>
            </div>
            <div>
                <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Ventas Totales</span>
                <div class="text-xl font-bold text-slate-900 font-mono">@_items.Count</div>
            </div>
        </div>

        <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-xs flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center text-lg">
                <i class="bi bi-currency-dollar"></i>
            </div>
            <div>
                <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Total Facturado</span>
                <div class="text-xl font-bold text-slate-900 font-mono">@TotalFacturado.ToString("C0")</div>
            </div>
        </div>

        <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-xs flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-lg bg-blue-50 text-blue-700 flex items-center justify-center text-lg">
                <i class="bi bi-receipt"></i>
            </div>
            <div>
                <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">IVA Generado</span>
                <div class="text-xl font-bold text-slate-900 font-mono">@TotalIva.ToString("C0")</div>
            </div>
        </div>

        <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-xs flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-lg bg-slate-100 text-slate-700 flex items-center justify-center text-lg">
                <i class="bi bi-shield-check"></i>
            </div>
            <div>
                <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Facturación DIAN</span>
                <div class="text-xs font-bold text-slate-700 flex items-center gap-1.5 mt-0.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Listo Factus
                </div>
            </div>
        </div>
    </div>

    <!-- Buscador y Filtros -->
    <div class="bg-white rounded-xl p-3.5 border border-slate-200 shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-3">
        <div class="relative flex-1">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                <i class="bi bi-search text-xs"></i>
            </div>
            <input type="text"
                   class="w-full pl-9 pr-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs focus:outline-none focus:ring-1 focus:ring-blue-600"
                   placeholder="Buscar venta por número, cliente, identificación..."
                   @bind="_search"
                   @bind:event="oninput"
                   @bind:after="FilterSales" />
        </div>

        <div class="flex items-center gap-2 text-xs text-slate-600">
            <span>Bodega:</span>
            <select class="py-1 px-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-medium text-slate-800 focus:outline-none cursor-pointer" @bind="_selectedWarehouseId" @bind:after="FilterSales">
                <option value="0">Todas las bodegas</option>
                @foreach (var b in _bodegas)
                {
                    <option value="@b.Id">@b.Name</option>
                }
            </select>
        </div>
    </div>

    <!-- Tabla de Ventas -->
    @if (_loading)
    {
        <div class="p-12 text-center bg-white rounded-xl border border-slate-200 shadow-xs">
            <div class="inline-block animate-spin rounded-full h-7 w-7 border-3 border-blue-600 border-t-transparent mb-2"></div>
            <p class="text-xs font-medium text-slate-600">Cargando transacciones...</p>
        </div>
    }
    else if (!_items.Any())
    {
        <div class="bg-white rounded-xl p-12 text-center border border-slate-200 shadow-xs">
            <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-2">
                <i class="bi bi-receipt text-xl"></i>
            </div>
            <h3 class="text-xs font-bold text-slate-800">No hay ventas registradas</h3>
            <p class="text-xs text-slate-400 mt-0.5">Abre la terminal de ventas para registrar la primera factura.</p>
            <div class="mt-3">
                <a href="/ventas/nueva" class="px-3.5 py-1.5 rounded-lg text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 transition-colors inline-flex items-center gap-1">
                    <i class="bi bi-plus-lg"></i> Abrir POS
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-slate-50 text-slate-500 uppercase tracking-wider font-semibold border-b border-slate-200">
                        <tr>
                            <th class="py-3 px-4">Comprobante</th>
                            <th class="py-3 px-4">Fecha / Hora</th>
                            <th class="py-3 px-4">Cliente</th>
                            <th class="py-3 px-4">Bodega</th>
                            <th class="py-3 px-3 text-right">Subtotal</th>
                            <th class="py-3 px-3 text-right">IVA</th>
                            <th class="py-3 px-4 text-right">Total</th>
                            <th class="py-3 px-3 text-center">Pago</th>
                            <th class="py-3 px-3 text-center">Factus</th>
                            <th class="py-3 px-4 text-right"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var v in _items)
                        {
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="py-2.5 px-4 font-mono font-bold text-slate-900">
                                    <a href="/ventas/@v.Id" class="text-blue-600 hover:underline">
                                        @v.SaleNumber
                                    </a>
                                </td>
                                <td class="py-2.5 px-4 text-slate-500">
                                    @v.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="py-2.5 px-4">
                                    <div class="font-semibold text-slate-800">@v.ClientName</div>
                                    <div class="text-[10px] text-slate-400 font-mono">@v.LineCount artículos</div>
                                </td>
                                <td class="py-2.5 px-4 text-slate-600">
                                    @v.WarehouseName
                                </td>
                                <td class="py-2.5 px-3 text-right font-mono text-slate-600">
                                    @v.Subtotal.ToString("C0")
                                </td>
                                <td class="py-2.5 px-3 text-right font-mono text-slate-500">
                                    @v.TaxAmount.ToString("C0")
                                </td>
                                <td class="py-2.5 px-4 text-right font-mono font-bold text-slate-900 text-xs">
                                    @v.Total.ToString("C0")
                                </td>
                                <td class="py-2.5 px-3 text-center">
                                    <span class="px-2 py-0.5 rounded-md text-[10px] font-semibold @(v.PaymentStatusDisplay.Contains("Pagado") || v.PaymentStatusDisplay.Contains("Paid") ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-amber-50 text-amber-700 border border-amber-200")">
                                        @v.PaymentStatusDisplay
                                    </span>
                                </td>
                                <td class="py-2.5 px-3 text-center">
                                    <span class="px-2 py-0.5 rounded-md text-[10px] font-semibold bg-slate-100 text-slate-600 border border-slate-200">
                                        @(v.FactusStatus ?? "Pendiente")
                                    </span>
                                </td>
                                <td class="py-2.5 px-4 text-right">
                                    <a href="/ventas/@v.Id" class="px-2.5 py-1 rounded-md text-[11px] font-semibold text-slate-700 bg-slate-50 hover:bg-slate-100 border border-slate-200 transition-colors inline-flex items-center gap-1">
                                        <i class="bi bi-eye"></i> Detalle
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
