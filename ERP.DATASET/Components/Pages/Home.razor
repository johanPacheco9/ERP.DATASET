@page "/"
@page "/dashboard"
@rendermode InteractiveServer

<div class="inv-page">
    <div class="inv-header">
        <div>
            <h1 class="inv-title">Inicio</h1>
            <p class="inv-subtitle">Estado del ERP — módulo inventario en desarrollo</p>
        </div>
        <a href="/inventario" class="btn btn-primary btn-sm">
            <i class="bi bi-box-seam me-1"></i> Ir a inventario
        </a>
    </div>

    @if (_loading)
    {
        <div class="inv-loading"><span class="spinner-border spinner-border-sm me-2"></span>Cargando datos…</div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-6 col-md">
                <div class="inv-stat">
                    <div class="inv-stat-value">@_productos</div>
                    <div class="inv-stat-label">Líneas de producto</div>
                </div>
            </div>
            <div class="col-6 col-md">
                <div class="inv-stat">
                    <div class="inv-stat-value">@_unidades</div>
                    <div class="inv-stat-label">Unidades en bodega</div>
                </div>
            </div>
            <div class="col-6 col-md">
                <div class="inv-stat">
                    <div class="inv-stat-value">@_bodegas</div>
                    <div class="inv-stat-label">Bodegas</div>
                </div>
            </div>
            <div class="col-6 col-md">
                <div class="inv-stat">
                    <div class="inv-stat-value">@_movimientos</div>
                    <div class="inv-stat-label">Movimientos</div>
                </div>
            </div>
            <div class="col-6 col-md">
                <div class="inv-stat">
                    <div class="inv-stat-value">@_auditorias</div>
                    <div class="inv-stat-label">Auditorías</div>
                </div>
            </div>
            <div class="col-6 col-md">
                <div class="inv-stat">
                    <div class="inv-stat-value">@_ventas</div>
                    <div class="inv-stat-label">Ventas</div>
                </div>
            </div>
            <div class="col-6 col-md">
                <div class="inv-stat">
                    <div class="inv-stat-value">@_alertasStock</div>
                    <div class="inv-stat-label">Alertas stock</div>
                </div>
            </div>
            <div class="col-6 col-md">
                <div class="inv-stat">
                    <div class="inv-stat-value">@_saldoCartera.ToString("C0")</div>
                    <div class="inv-stat-label">Cartera</div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="inv-card">
                    <div class="inv-card-header">Mapa del sistema</div>
                    <div class="p-3">
                        <div class="inv-roadmap-item">
                            <span class="inv-roadmap-dot inv-roadmap-dot--done"></span>
                            <div>
                                <strong>Inventario — catálogo</strong>
                                <div class="text-muted small">Productos, categorías, variantes, proveedores</div>
                            </div>
                        </div>
                        <div class="inv-roadmap-item">
                            <span class="inv-roadmap-dot inv-roadmap-dot--done"></span>
                            <div>
                                <strong>Inventario — operación</strong>
                                <div class="text-muted small">Bodegas, movimientos (entrada/salida), unidades serializadas</div>
                            </div>
                        </div>
                        <div class="inv-roadmap-item">
                            <span class="inv-roadmap-dot inv-roadmap-dot--wip"></span>
                            <div>
                                <strong>Inventario — auditorías</strong>
                                <div class="text-muted small">Crear, listar y registrar conteo físico</div>
                            </div>
                        </div>
                        <div class="inv-roadmap-item">
                            <span class="inv-roadmap-dot inv-roadmap-dot--done"></span>
                            <div>
                                <strong>Ventas</strong>
                                <div class="text-muted small">Descuenta unidades, movimientos de salida, pagos y cartera</div>
                            </div>
                        </div>
                        <div class="inv-roadmap-item">
                            <span class="inv-roadmap-dot inv-roadmap-dot--done"></span>
                            <div>
                                <strong>Alertas operativas</strong>
                                <div class="text-muted small">Cartera pendiente y stock bajo por bodega</div>
                            </div>
                        </div>
                        <div class="inv-roadmap-item">
                            <span class="inv-roadmap-dot inv-roadmap-dot--done"></span>
                            <div>
                                <strong>Clientes</strong>
                                <div class="text-muted small">Maestro y enlace a ventas</div>
                            </div>
                        </div>
                        <div class="inv-roadmap-item">
                            <span class="inv-roadmap-dot inv-roadmap-dot--todo"></span>
                            <div>
                                <strong>Compras</strong>
                                <div class="text-muted small">Órdenes de compra y recepción contra proveedores</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="inv-card">
                    <div class="inv-card-header">Accesos rápidos</div>
                    <div class="p-3 d-grid gap-2">
                        <a href="/ProductosDashboard" class="btn btn-outline-secondary btn-sm text-start">
                            <i class="bi bi-tag me-2"></i>Catálogo
                        </a>
                        <a href="/unidades" class="btn btn-outline-secondary btn-sm text-start">
                            <i class="bi bi-upc-scan me-2"></i>Unidades
                        </a>
                        <a href="/movimientos" class="btn btn-outline-secondary btn-sm text-start">
                            <i class="bi bi-arrow-left-right me-2"></i>Movimientos
                        </a>
                        <a href="/stock-alertas" class="btn btn-outline-secondary btn-sm text-start">
                            <i class="bi bi-exclamation-triangle me-2"></i>Alertas de stock
                        </a>
                        <a href="/ventas/nueva" class="btn btn-outline-secondary btn-sm text-start">
                            <i class="bi bi-cart-plus me-2"></i>Nueva venta
                        </a>
                        <a href="/cartera" class="btn btn-outline-secondary btn-sm text-start">
                            <i class="bi bi-cash-stack me-2"></i>Cartera
                        </a>
                        <a href="/auditorias" class="btn btn-outline-secondary btn-sm text-start">
                            <i class="bi bi-clipboard-check me-2"></i>Auditorías
                        </a>
                        <a href="/bodegas" class="btn btn-outline-secondary btn-sm text-start">
                            <i class="bi bi-building me-2"></i>Bodegas
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
