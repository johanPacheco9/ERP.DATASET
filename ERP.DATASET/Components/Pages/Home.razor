                <div class="inv-marquee-track flex w-max gap-3 px-3">
                    @for (int _i = 0; _i < 2; _i++)
                    {
                        <div class="flex gap-3 shrink-0">
                            <a href="/ProductosDashboard" class="group flex min-w-[152px] flex-col gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md">
                                <div class="flex items-center gap-2">
                                    <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-slate-100 text-slate-500 transition-transform duration-200 group-hover:scale-110">
                                        <i class="bi bi-tag text-xs"></i>
                                    </span>
                                    <span class="text-[10px] font-semibold uppercase tracking-wide text-slate-400">Producto</span>
                                </div>
                                <div class="text-2xl font-bold tabular-nums leading-none text-slate-900">@_productos</div>
                                <div class="h-[3px] w-full rounded-full bg-slate-100 overflow-hidden">
                                    <div class="h-full w-full rounded-full bg-slate-300"></div>
                                </div>
                            </a>
                            <a href="/unidades" class="group flex min-w-[152px] flex-col gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md">
                                <div class="flex items-center gap-2">
                                    <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-slate-100 text-slate-500 transition-transform duration-200 group-hover:scale-110">
                                        <i class="bi bi-boxes text-xs"></i>
                                    </span>
                                    <span class="text-[10px] font-semibold uppercase tracking-wide text-slate-400">Unidades</span>
                                </div>
                                <div class="text-2xl font-bold tabular-nums leading-none text-slate-900">@_unidades</div>
                                <div class="h-[3px] w-full rounded-full bg-slate-100 overflow-hidden">
                                    <div class="h-full w-full rounded-full bg-slate-300"></div>
                                </div>
                            </a>
                            <a href="/bodegas" class="group flex min-w-[152px] flex-col gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md">
