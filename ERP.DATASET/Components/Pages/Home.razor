@page "/"
@page "/dashboard"
@rendermode InteractiveServer

<PageTitle>Inicio · ERP</PageTitle>

<style>
    @@keyframes inv-marquee {
        from { transform: translateX(0); }
        to   { transform: translateX(-50%); }
    }
    .inv-marquee-track {
        animation: inv-marquee 32s linear infinite;
    }
    .inv-marquee-wrap:hover .inv-marquee-track {
        animation-play-state: paused;
    }
    .inv-marquee-mask {
        -webkit-mask-image: linear-gradient(to right, transparent 0, black 32px, black calc(100% - 32px), transparent 100%);
        mask-image: linear-gradient(to right, transparent 0, black 32px, black calc(100% - 32px), transparent 100%);
    }
</style>

<div class="max-w-6xl mx-auto px-4 sm:px-6 py-5 font-sans text-slate-900">

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 mb-4 border-b border-slate-200">
        <div>
            <span class="block text-[11px] font-semibold tracking-wide uppercase text-blue-700">
                ERP · Panel general
            </span>
            <h1 class="text-xl font-bold tracking-tight text-slate-900 leading-tight">Inicio</h1>
            <p class="text-xs text-slate-500 mt-0.5">Estado del sistema — módulo de inventario en desarrollo</p>
        </div>
        <a href="/inventario"
           class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-lg bg-black px-3.5 py-2 text-xs font-semibold text-white shadow-sm transition-all duration-200 hover:bg-blue-700 hover:-translate-y-0.5 hover:shadow-md active:translate-y-0 w-full sm:w-auto">
            <i class="bi bi-box-seam"></i> Ir a inventario
        </a>
    </div>

    @if (_loading)
    {
        <div class="flex items-center justify-center gap-3 py-12 text-sm text-slate-500">
            <span class="h-4 w-4 rounded-full border-2 border-slate-200 border-t-blue-600 animate-spin"></span>
            Cargando datos…
        </div>
    }
    else
    {
        <div class="flex flex-col gap-4">

            <!-- Ticker de indicadores: tarjetas elevadas individuales dentro del loop, en vez de filas planas pegadas -->
