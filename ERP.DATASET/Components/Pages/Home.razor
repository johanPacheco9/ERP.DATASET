@page "/"
@page "/dashboard"

<div class="dashboard">

    <!-- Header -->
    <div class="mb-4">
        <h1 class="dashboard-title">Dashboard</h1>
        <p class="text-muted">Bienvenido al sistema de gestión empresarial</p>
    </div>

    <!-- Stats -->
    <div class="row g-4">
        @foreach (var stat in Stats)
        {
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card stat-card h-100">
                    <div class="card-body d-flex justify-content-between">
                        <div>
                            <small class="text-muted">@stat.Title</small>
                            <h4 class="fw-semibold mb-0">@stat.Value</h4>
                        </div>

                        <span class="badge stat-badge @(stat.IsPositive ? "bg-success" : "bg-danger")">
                            @stat.Change
                        </span>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Charts -->
    <div class="row g-4 mt-4">
        <div class="col-lg-6">
            <div class="card dashboard-card">
                <div class="card-header">Ventas vs Compras</div>
                <div class="card-body">
                    <canvas id="ventasChart" height="120"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card dashboard-card">
                <div class="card-header">Distribución por Categoría</div>
                <div class="card-body">
                    <canvas id="categoriasChart" height="120"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Orders -->
    <div class="card dashboard-card mt-4">
        <div class="card-header">Órdenes Recientes</div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Cliente</th>
                        <th>Producto</th>
                        <th class="text-end">Monto</th>
                        <th class="text-center">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Orders)
                    {
                        <tr>
                            <td class="fw-medium">@order.Id</td>
                            <td>@order.Cliente</td>
                            <td class="text-muted">@order.Producto</td>
                            <td class="text-end fw-semibold">@order.Monto</td>
                            <td class="text-center">
                                <span class="badge estado-badge @GetEstadoClass(order.Estado)">
                                    @order.Estado
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
