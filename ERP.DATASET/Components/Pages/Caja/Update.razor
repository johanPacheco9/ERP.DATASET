@page "/cajas/editar/{Id:int}"
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="max-w-4xl mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Editar Caja / Terminal POS</h1>
        <button @class="bg-gray-200 hover:bg-gray-300 text-gray-700 px-4 py-2 rounded-lg text-sm font-semibold transition-colors" @onclick='() => Navigation.NavigateTo("/cajas")'>
            Volver
        </button>
    </div>

    @if (_isLoading)
    {
        <div class="flex justify-center items-center py-12">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600"></div>
        </div>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded-lg text-sm">
            @_errorMessage
        </div>
    }
    else
    {
        <EditForm Model="_updateForm" OnValidSubmit="UpdateCaja">
            <DataAnnotationsValidator />

            <div class="bg-white shadow-sm rounded-xl border border-gray-200 p-6 space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Nombre de la Caja</label>
                        <InputText class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm py-2 px-3 border bg-white" @bind-Value="_updateForm.Name" />
                        <ValidationMessage For="() => _updateForm.Name" class="text-rose-600 text-xs mt-1" />
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Código</label>
                        <InputText class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm py-2 px-3 border bg-white" @bind-Value="_updateForm.Code" />
                        <ValidationMessage For="() => _updateForm.Code" class="text-rose-600 text-xs mt-1" />
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Prefijo de Facturación</label>
                        <InputText class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm py-2 px-3 border bg-white" @bind-Value="_updateForm.Prefix" />
                        <ValidationMessage For="() => _updateForm.Prefix" class="text-rose-600 text-xs mt-1" />
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Consecutivo Actual</label>
                        <InputNumber class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm py-2 px-3 border bg-white" @bind-Value="_updateForm.CurrentConsecutive" />
                        <ValidationMessage For="() => _updateForm.CurrentConsecutive" class="text-rose-600 text-xs mt-1" />
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Número de Resolución DIAN</label>
                        <InputText class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm py-2 px-3 border bg-white" @bind-Value="_updateForm.DianResolutionNumber" />
                        <ValidationMessage For="() => _updateForm.DianResolutionNumber" class="text-rose-600 text-xs mt-1" />
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Fecha Resolución DIAN</label>
                        <InputText class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm py-2 px-3 border bg-white" @bind-Value="_updateForm.DianResolutionDate" />
                        <ValidationMessage For="() => _updateForm.DianResolutionDate" class="text-rose-600 text-xs mt-1" />
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Número Inicial</label>
                        <InputNumber class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm py-2 px-3 border bg-white" @bind-Value="_updateForm.FromNumber" />
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Número Final</label>
                        <InputNumber class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm py-2 px-3 border bg-white" @bind-Value="_updateForm.ToNumber" />
                    </div>
                </div>

                <div class="flex items-center gap-2 pt-2">
                    <InputCheckbox id="isActive" @bind-Value="_updateForm.IsActive" class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 h-4 w-4" />
                    <label for="isActive" class="text-sm font-medium text-gray-700">Caja Activa</label>
                </div>

                <div class="flex justify-end gap-3 pt-4 border-t border-gray-100">
                    <button type="button" @onclick='() => Navigation.NavigateTo("/cajas")' class="px-4 py-2 text-sm font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors">
                        Cancelar
                    </button>
                    <button type="submit" disabled="@_isSubmitting" class="px-4 py-2 text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg transition-colors disabled:opacity-50">
                        @(_isSubmitting ? "Guardando..." : "Guardar Cambios")
                    </button>
                </div>
            </div>
        </EditForm>
    }
</div>