@page "/caja/abrir"
@attribute [Authorize(Roles = AppPermissions.Policies.CashRegisterOperation)]
@rendermode InteractiveServer

<div class="max-w-2xl mx-auto p-4 sm:p-6 space-y-6 mt-6">
    @if (_isLoading)
    {
        <div class="bg-white rounded-2xl p-12 shadow-sm border border-slate-200 text-center space-y-3">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-3 border-emerald-500 border-t-transparent"></div>
            <p class="text-xs font-semibold text-slate-600">Verificando estado de caja y terminales...</p>
        </div>
    }
    else if (_activeShift != null)
    {
        <!-- Panel cuando el cajero YA TIENE una caja abierta -->
        <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-slate-200 space-y-6">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-2xl font-bold border border-emerald-100 shrink-0">
                    <i class="bi bi-shop-window"></i>
                </div>
                <div>
                    <span class="px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-bold text-[11px] border border-emerald-200 inline-block mb-1">
                        Turno de Caja Activo
                    </span>
                    <h1 class="text-xl font-bold text-slate-800 tracking-tight">Turno #@_activeShift.ShiftId en @_activeShift.TerminalName</h1>
                    <p class="text-xs text-slate-500 mt-0.5">Sucursal: <strong class="text-slate-700">@_activeShift.StoreName</strong> • Abierto el @_activeShift.OpenedAt.ToLocalTime().ToString("dd/MM/yyyy hh:mm tt")</p>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4 bg-slate-50 p-4 rounded-xl border border-slate-200/80 text-xs">
                <div>
                    <span class="text-slate-400 block font-medium">Base Inicial de Efectivo</span>
                    <span class="text-base font-bold font-mono text-slate-800">@_activeShift.InitialCash.ToString("C0")</span>
                </div>
                <div>
                    <span class="text-slate-400 block font-medium">Código de Terminal</span>
                    <span class="text-base font-bold font-mono text-slate-800">@_activeShift.TerminalCode</span>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded-xl text-xs flex items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill text-sm"></i>
                    <span>@_errorMessage</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(_successMessage))
            {
                <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 px-4 py-3 rounded-xl text-xs flex items-center gap-2">
                    <i class="bi bi-check-circle-fill text-sm"></i>
                    <span>@_successMessage</span>
                </div>
            }

            <div class="pt-2 flex flex-col sm:flex-row items-center gap-3">
                <a href="/ventas/nueva" class="w-full sm:w-auto flex-1 px-5 py-2.5 rounded-xl text-xs font-bold text-slate-950 bg-gradient-to-r from-emerald-400 via-emerald-500 to-teal-400 hover:from-emerald-300 hover:to-teal-300 shadow-md shadow-emerald-500/20 transition-all flex items-center justify-center gap-2">
                    <i class="bi bi-upc-scan"></i> Ir a Vender (POS)
                </a>
                <button type="button" @onclick="OpenCloseShiftModal" class="w-full sm:w-auto px-4 py-2.5 rounded-xl text-xs font-bold text-rose-700 bg-rose-50 hover:bg-rose-100 transition-colors border border-rose-200 flex items-center justify-center gap-2">
                    <i class="bi bi-door-closed-fill"></i> Arqueo & Cerrar Turno
                </button>
            </div>
        </div>
    }
    else
    {
        <!-- Header Apertura -->
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200 text-center">
            <div class="w-14 h-14 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-2xl font-bold border border-emerald-100 mx-auto mb-3">
                <i class="bi bi-door-open-fill"></i>
            </div>
            <span class="px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-semibold text-xs border border-emerald-200">
                Punto de Venta
            </span>
            <h1 class="text-2xl font-bold text-slate-800 tracking-tight mt-1.5">Apertura de Caja</h1>
            <p class="text-xs text-slate-500 mt-1">Seleccione su terminal asignada e ingrese la base en efectivo para iniciar su turno.</p>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded-xl text-xs flex items-center gap-2 shadow-sm">
                <i class="bi bi-exclamation-triangle-fill text-sm"></i>
                <span>@_errorMessage</span>
            </div>
        }

        <!-- Formulario de Apertura -->
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200 space-y-4">
            <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
                    Terminal POS (Caja Física)
                </label>
                @if (!_availableTerminals.Any())
                {
                    <div class="p-4 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 text-xs">
                        <i class="bi bi-info-circle-fill mr-1"></i> No se encontraron terminales de caja disponibles en su sucursal. Contacte a un administrador para asignarle una sucursal o activar una caja.
                    </div>
                }
                else
                {
                    <select @bind="_request.PosTerminalId" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 font-medium text-slate-800">
                        <option value="0">Seleccione su terminal de caja...</option>
                        @foreach (var term in _availableTerminals)
                        {
                            <option value="@term.Id" disabled="@term.HasActiveShift">
                                @term.StoreName — @term.Name (@term.Code) @(term.HasActiveShift ? $"[Ocupada por {term.ActiveCashierName}]" : "[Disponible]")
                            </option>
                        }
                    </select>
                }
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Base Inicial (Fondo de Cambio)</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 font-mono font-bold">
                        $
                    </div>
                    <input type="number" 
                           @bind="_request.InitialCash" 
                           class="w-full pl-8 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-mono font-bold text-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-500" 
                           placeholder="0" />
                </div>
                <p class="text-[11px] text-slate-400 mt-1">Efectivo en billetes y monedas con el que arranca la gaveta.</p>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Observaciones de Apertura (Opcional)</label>
                <input type="text" 
                       @bind="_request.Notes" 
                       class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-500" 
                       placeholder="Ej. Novedades sobre el estado de la terminal o billetes..." />
            </div>

            <div class="pt-4 flex items-center justify-end gap-3 border-t border-slate-100">
                <a href="/" class="px-4 py-2.5 rounded-xl text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 transition-colors border border-slate-200">
                    Cancelar
                </a>
                <button type="button" 
                        @onclick="HandleOpenShift" 
                        disabled="@(_isSubmitting || !_availableTerminals.Any(t => !t.HasActiveShift))"
                        class="px-5 py-2.5 rounded-xl text-sm font-bold text-slate-950 bg-gradient-to-r from-emerald-400 via-emerald-500 to-teal-400 hover:from-emerald-300 hover:to-teal-300 shadow-md shadow-emerald-500/20 transition-all flex items-center gap-2 disabled:opacity-50">
                    @if (_isSubmitting)
                    {
                        <div class="inline-block animate-spin rounded-full h-4 w-4 border-2 border-slate-950 border-t-transparent"></div>
                        <span>Abriendo...</span>
                    }
                    else
                    {
                        <i class="bi bi-check2-circle"></i>
                        <span>Abrir Turno de Caja</span>
                    }
                </button>
            </div>
        </div>
    }
</div>

<!-- Modal para Arqueo y Cierre de Caja -->
@if (_showCloseModal && _activeShift != null)
{
    <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200 space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center font-bold text-sm border border-rose-100">
                        <i class="bi bi-calculator"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-slate-800">Cierre y Arqueo de Caja</h3>
                        <span class="text-[10px] text-slate-400">Turno #@_activeShift.ShiftId</span>
                    </div>
                </div>
                <button @onclick="CloseCloseShiftModal" class="text-slate-400 hover:text-slate-600">
                    <i class="bi bi-x-lg text-sm"></i>
                </button>
            </div>

            @if (!string.IsNullOrEmpty(_closeModalError))
            {
                <div class="bg-rose-50 border border-rose-200 text-rose-700 px-3 py-2 rounded-xl text-xs flex items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>@_closeModalError</span>
                </div>
            }

            <div class="space-y-3 text-xs">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
                        Efectivo Real Contado en Gaveta ($)
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400 font-mono font-bold">
                            $
                        </div>
                        <input type="number" 
                               @bind="_closeRequest.ActualCash" 
                               class="w-full pl-8 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm font-mono font-bold text-slate-800 focus:ring-2 focus:ring-emerald-500 focus:outline-none" 
                               placeholder="0" />
                    </div>
                    <p class="text-[10px] text-slate-400 mt-1">Conteo físico exacto de billetes y monedas.</p>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
                        Novedades o Notas de Cierre (Opcional)
                    </label>
                    <textarea @bind="_closeRequest.Notes" 
                              rows="2" 
                              class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:ring-2 focus:ring-emerald-500 focus:outline-none" 
                              placeholder="Observaciones de descuadre, gastos menores, etc..."></textarea>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-3 border-t border-slate-100">
                <button @onclick="CloseCloseShiftModal" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 border border-slate-200 transition-colors">
                    Cancelar
                </button>
                <button @onclick="ExecuteCloseShift" disabled="@_isClosing" class="px-4 py-2 rounded-xl text-xs font-bold text-white bg-rose-600 hover:bg-rose-500 shadow-md shadow-rose-600/20 transition-all flex items-center gap-1.5 disabled:opacity-50">
                    @if (_isClosing)
                    {
                        <div class="inline-block animate-spin rounded-full h-3 w-3 border-2 border-white border-t-transparent"></div>
                        <span>Cerrando...</span>
                    }
                    else
                    {
                        <i class="bi bi-check2-circle"></i>
                        <span>Confirmar Cierre</span>
                    }
                </button>
            </div>
        </div>
    </div>
}