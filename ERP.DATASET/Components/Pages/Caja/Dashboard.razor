@page "/caja/abrir"
@rendermode InteractiveServer

<div class="max-w-xl mx-auto p-4 sm:p-6 space-y-6 mt-10">
    <!-- Header Apertura -->
    <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200 text-center">
        <div class="w-16 h-16 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-2xl font-bold border border-emerald-100 mx-auto mb-4">
            <i class="bi bi-door-open-fill"></i>
        </div>
        <span class="px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-semibold text-xs border border-emerald-200">
            Control de Caja
        </span>
        <h1 class="text-2xl font-bold text-slate-800 tracking-tight mt-1">Apertura de Turno</h1>
        <p class="text-xs text-slate-500 mt-1">Configure la base inicial de efectivo para comenzar a operar el punto de venta</p>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded-xl text-xs flex items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill text-sm"></i>
            <span>@_errorMessage</span>
        </div>
    }

    <!-- Formulario -->
    <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200 space-y-4">
        <div>
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Terminal POS (Caja Física)</label>
            <select @bind="_request.PosTerminalId" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 font-medium text-slate-800">
                <option value="0">Seleccione una terminal...</option>
                <!-- Aquí puedes iterar tus terminales reales si las cargas en el OnInitialized -->
                <option value="1">Caja Principal 01</option>
                <option value="2">Caja Rápida 02</option>
            </select>
        </div>

        <div>
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Base Inicial (Efectivo en Caja)</label>
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 font-mono font-bold">
                    $
                </div>
                <input type="number" 
                       @bind="_request.InitialCash" 
                       class="w-full pl-8 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-mono font-bold text-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-500" 
                       placeholder="0" />
            </div>
            <p class="text-[11px] text-slate-400 mt-1">Ingrese el valor total de billetes y monedas destinados para dar devueltas.</p>
        </div>

        <div class="pt-4 flex items-center justify-end gap-3">
            <a href="/cartera" class="px-4 py-2.5 rounded-xl text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 transition-colors border border-slate-200">
                Cancelar
            </a>
            <button type="button" 
                    @onclick="HandleOpenShift" 
                    disabled="@_isSubmitting"
                    class="px-5 py-2.5 rounded-xl text-sm font-bold text-slate-950 bg-gradient-to-r from-emerald-400 via-emerald-500 to-teal-400 hover:from-emerald-300 hover:to-teal-300 shadow-md shadow-emerald-500/20 transition-all flex items-center gap-2 disabled:opacity-50">
                @if (_isSubmitting)
                {
                    <div class="inline-block animate-spin rounded-full h-4 w-4 border-2 border-slate-950 border-t-transparent"></div>
                    <span>Abriendo...</span>
                }
                else
                {
                    <i class="bi bi-check2-circle"></i>
                    <span>Abrir Turno de Caja</span>
                }
            </button>
        </div>
    </div>
</div>