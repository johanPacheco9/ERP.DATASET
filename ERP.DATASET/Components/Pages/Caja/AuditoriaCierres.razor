@page "/caja/auditoria"
@attribute [Authorize(Roles = AppPermissions.Policies.SupervisorOrAdmin)]
@rendermode InteractiveServer

<div class="max-w-[1600px] mx-auto space-y-5">
    <div class="bg-white rounded-xl p-4 sm:p-5 border border-slate-200 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <span class="px-2 py-0.5 rounded-md bg-amber-50 text-amber-700 font-semibold text-[11px] border border-amber-200">
                    Auditoría de Caja
                </span>
            </div>
            <h1 class="text-xl font-bold text-slate-900 tracking-tight">Cierres de Caja</h1>
            <p class="text-xs text-slate-500 mt-0.5">Revisión de arqueos, diferencias (faltantes/sobrantes) y cuadre por turno</p>
        </div>
        <a href="/cajas" class="px-3.5 py-2 rounded-lg text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 transition-colors flex items-center gap-1.5 border border-slate-200">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="p-3 bg-rose-50 border border-rose-200 text-rose-800 rounded-lg text-xs flex items-center gap-2">
            <i class="bi bi-exclamation-octagon-fill text-rose-600 text-sm"></i>
            <span>@_error</span>
        </div>
    }

    <!-- Filtros -->
    <div class="bg-white rounded-xl p-3.5 border border-slate-200 shadow-xs flex flex-col md:flex-row md:items-end gap-3">
        <div class="flex flex-col gap-1">
            <label class="text-[11px] font-semibold text-slate-500 uppercase">Desde</label>
            <input type="date" class="py-1.5 px-2 bg-slate-50 border border-slate-200 rounded-lg text-xs" @bind="_fromDate" />
        </div>
        <div class="flex flex-col gap-1">
            <label class="text-[11px] font-semibold text-slate-500 uppercase">Hasta</label>
            <input type="date" class="py-1.5 px-2 bg-slate-50 border border-slate-200 rounded-lg text-xs" @bind="_toDate" />
        </div>
        <div class="flex flex-col gap-1">
            <label class="text-[11px] font-semibold text-slate-500 uppercase">Terminal</label>
            <select class="py-1.5 px-2 bg-slate-50 border border-slate-200 rounded-lg text-xs" @bind="_terminalId">
                <option value="0">Todas</option>
                @foreach (var t in _terminals)
                {
                    <option value="@t.Id">@t.Name (@t.Code)</option>
                }
            </select>
        </div>
        <div class="flex flex-col gap-1">
            <label class="text-[11px] font-semibold text-slate-500 uppercase">Cajero</label>
            <select class="py-1.5 px-2 bg-slate-50 border border-slate-200 rounded-lg text-xs" @bind="_cashierId">
                <option value="0">Todos</option>
                @foreach (var c in _cashiers)
                {
                    <option value="@c.UsuarioId">@c.NombreCompleto</option>
                }
            </select>
        </div>
        <button type="button" class="px-3.5 py-1.5 rounded-lg text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 transition-colors" @onclick="ApplyFilters">
            <i class="bi bi-funnel"></i> Filtrar
        </button>
    </div>

    @if (_loading)
    {
        <div class="p-12 text-center bg-white rounded-xl border border-slate-200 shadow-xs">
            <div class="inline-block animate-spin rounded-full h-7 w-7 border-3 border-blue-600 border-t-transparent mb-2"></div>
            <p class="text-xs font-medium text-slate-600">Cargando cierres...</p>
        </div>
    }
    else if (!_items.Any())
    {
        <div class="bg-white rounded-xl p-12 text-center border border-slate-200 shadow-xs">
            <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-2">
                <i class="bi bi-inbox text-xl"></i>
            </div>
            <h3 class="text-xs font-bold text-slate-800">No hay cierres registrados</h3>
        </div>
    }
    else
    {
        <div class="bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-slate-50 text-slate-500 uppercase tracking-wider font-semibold border-b border-slate-200">
                        <tr>
                            <th class="py-3 px-4">Turno</th>
                            <th class="py-3 px-4">Terminal</th>
                            <th class="py-3 px-4">Cajero</th>
                            <th class="py-3 px-4">Apertura</th>
                            <th class="py-3 px-4">Cierre</th>
                            <th class="py-3 px-3 text-right">Esperado</th>
                            <th class="py-3 px-3 text-right">Contado</th>
                            <th class="py-3 px-3 text-right">Diferencia</th>
                            <th class="py-3 px-4 text-right"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var c in _items)
                        {
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="py-2.5 px-4 font-mono font-bold text-slate-900">#@c.Id</td>
                                <td class="py-2.5 px-4 text-slate-600">@c.TerminalName <span class="text-[10px] text-slate-400">(@c.TerminalCode)</span></td>
                                <td class="py-2.5 px-4 text-slate-700">@c.CashierName</td>
                                <td class="py-2.5 px-4 text-slate-500">@c.OpenedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="py-2.5 px-4 text-slate-500">@(c.ClosedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                                <td class="py-2.5 px-3 text-right font-mono text-slate-600">@c.TotalExpectedCash.ToString("C0")</td>
                                <td class="py-2.5 px-3 text-right font-mono text-slate-600">@(c.ActualCash?.ToString("C0") ?? "—")</td>
                                <td class="py-2.5 px-3 text-right font-mono font-bold @(c.Difference == 0 ? "text-emerald-700" : (c.Difference > 0 ? "text-blue-700" : "text-rose-700"))">
                                    @(c.Difference?.ToString("C0") ?? "—")
                                </td>
                                <td class="py-2.5 px-4 text-right">
                                    <button type="button" class="px-2.5 py-1 rounded-md text-[11px] font-semibold text-slate-700 bg-slate-50 hover:bg-slate-100 border border-slate-200 transition-colors inline-flex items-center gap-1" @onclick="() => OpenDetail(c.Id)">
                                        <i class="bi bi-eye"></i> Detalle
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Paginación -->
            <div class="px-4 py-3 border-t border-slate-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-xs">
                <div class="text-slate-500">
                    Mostrando @((_pageNumber - 1) * _pageSize + 1)-@(Math.Min(_pageNumber * _pageSize, _totalCount)) de @_totalCount cierres
                </div>
                <div class="flex items-center gap-2">
                    <button type="button" class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 disabled:opacity-40" disabled="@(_pageNumber <= 1)" @onclick="() => GoToPage(_pageNumber - 1)">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <span class="font-mono text-slate-600">Pág. @_pageNumber / @_totalPages</span>
                    <button type="button" class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 disabled:opacity-40" disabled="@(_pageNumber >= _totalPages)" @onclick="() => GoToPage(_pageNumber + 1)">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Modal Detalle -->
    @if (_showDetail)
    {
        <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-2xs z-50 flex items-center justify-center p-4">
            <div class="bg-white rounded-xl shadow-xl border border-slate-200 max-w-3xl w-full overflow-hidden max-h-[90vh] flex flex-col">
                <div class="p-4 border-b border-slate-200 flex items-center justify-between">
                    <h3 class="font-bold text-sm text-slate-800 flex items-center gap-2">
                        <i class="bi bi-receipt-cutoff text-blue-600"></i> Detalle de Cierre #@(_detail?.Id)
                    </h3>
                    <button type="button" class="text-slate-400 hover:text-slate-600 text-lg" @onclick="CloseDetail">&times;</button>
                </div>
                <div class="p-4 overflow-y-auto space-y-4 text-xs">
                    @if (_loadingDetail || _detail == null)
                    {
                        <div class="text-center py-8 text-slate-400">Cargando...</div>
                    }
                    else
                    {
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                            <div class="bg-slate-50 rounded-lg p-2.5 border border-slate-200">
                                <span class="text-[10px] text-slate-400 block">Terminal</span>
                                <span class="font-bold text-slate-800">@_detail.TerminalName</span>
                            </div>
                            <div class="bg-slate-50 rounded-lg p-2.5 border border-slate-200">
                                <span class="text-[10px] text-slate-400 block">Cajero</span>
                                <span class="font-bold text-slate-800">@_detail.CashierName</span>
                            </div>
                            <div class="bg-slate-50 rounded-lg p-2.5 border border-slate-200">
                                <span class="text-[10px] text-slate-400 block">Apertura</span>
                                <span class="font-mono text-slate-700">@_detail.OpenedAt.ToLocalTime().ToString("dd/MM HH:mm")</span>
                            </div>
                            <div class="bg-slate-50 rounded-lg p-2.5 border border-slate-200">
                                <span class="text-[10px] text-slate-400 block">Cierre</span>
                                <span class="font-mono text-slate-700">@(_detail.ClosedAt?.ToLocalTime().ToString("dd/MM HH:mm") ?? "—")</span>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                            <div class="bg-slate-50 rounded-lg p-2.5 border border-slate-200">
                                <span class="text-[10px] text-slate-400 block">Base inicial</span>
                                <span class="font-mono font-bold text-slate-800">@_detail.InitialCash.ToString("C0")</span>
                            </div>
                            <div class="bg-slate-50 rounded-lg p-2.5 border border-slate-200">
                                <span class="text-[10px] text-slate-400 block">Ventas efectivo</span>
                                <span class="font-mono text-slate-700">@_detail.CashSales.ToString("C0")</span>
                            </div>
                            <div class="bg-slate-50 rounded-lg p-2.5 border border-slate-200">
                                <span class="text-[10px] text-slate-400 block">Esperado</span>
                                <span class="font-mono font-bold text-slate-800">@_detail.TotalExpectedCash.ToString("C0")</span>
                            </div>
                            <div class="bg-slate-50 rounded-lg p-2.5 border border-slate-200">
                                <span class="text-[10px] text-slate-400 block">Contado</span>
                                <span class="font-mono text-slate-700">@(_detail.ActualCash?.ToString("C0") ?? "—")</span>
                            </div>
                        </div>

                        <div class="p-2.5 rounded-lg border @( _detail.Difference == 0 ? "bg-emerald-50 border-emerald-200 text-emerald-800" : (_detail.Difference > 0 ? "bg-blue-50 border-blue-200 text-blue-800" : "bg-rose-50 border-rose-200 text-rose-800")) font-bold flex items-center justify-between">
                            <span>Diferencia (sobrante/faltante)</span>
                            <span class="font-mono">@(_detail.Difference?.ToString("C0") ?? "—")</span>
                        </div>

                        @if (!string.IsNullOrEmpty(_detail.Notes))
                        {
                            <div class="p-2.5 bg-slate-50 rounded-lg border border-slate-200 text-slate-600">
                                <span class="font-bold text-slate-700 block mb-0.5">Notas:</span>
                                @_detail.Notes
                            </div>
                        }

                        <div>
                            <h4 class="font-bold text-slate-700 mb-1.5">Ventas del turno (@_detail.Sales.Count)</h4>
                            @if (!_detail.Sales.Any())
                            {
                                <p class="text-slate-400">Sin ventas registradas.</p>
                            }
                            else
                            {
                                <div class="overflow-x-auto">
                                    <table class="w-full text-left text-[11px]">
                                        <thead class="bg-slate-50 text-slate-500 uppercase tracking-wider font-semibold border-b border-slate-200">
                                            <tr>
                                                <th class="py-2 px-2">Comprobante</th>
                                                <th class="py-2 px-2">Cliente</th>
                                                <th class="py-2 px-2 text-right">Total</th>
                                                <th class="py-2 px-2 text-center">Pago</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-100">
                                            @foreach (var v in _detail.Sales)
                                            {
                                                <tr>
                                                    <td class="py-1.5 px-2 font-mono text-slate-900">@v.SaleNumber</td>
                                                    <td class="py-1.5 px-2 text-slate-600">@v.ClientName</td>
                                                    <td class="py-1.5 px-2 text-right font-mono">@v.Total.ToString("C0")</td>
                                                    <td class="py-1.5 px-2 text-center text-slate-500">@v.PaymentStatusDisplay</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>
