@page "/inventario/compras/crear"
@using ERP.DATA.Services.InventarioService.OrdenesDeCompra
@using ERP.DATA.Services.Inventario.ProveedorService
@using ERP.DATA.Services.InventarioService.ProductoBaseService
@using ERP.TRAN.CrossLayers.API.Inventario.OrdenDeCompra.Requests
@inject OrdenesDeCompraManager Ordenes
@inject SupplierService ProveedoresService
@inject ProductoBaseService ProductosService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Nueva orden de compra</PageTitle>

<div class="p-6 bg-slate-50 min-h-screen max-w-6xl">
    <a href="/inventario/compras" class="text-sm text-slate-500 hover:text-blue-600"><i class="bi bi-arrow-left"></i> Órdenes de compra</a>
    <h1 class="mt-3 text-2xl font-bold text-slate-800">Nueva orden de compra</h1>
    <p class="mt-1 text-sm text-slate-500">La orden queda pendiente de aprobación; todavía no afecta inventario.</p>

    @if (!string.IsNullOrWhiteSpace(Error)) { <div class="mt-5 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">@Error</div> }

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        @if (Cargando)
        {
            <div class="py-8 text-center text-slate-500">Cargando proveedores y productos...</div>
        }
        else
        {
            <div class="grid gap-4 md:grid-cols-2">
                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-700">Proveedor</label>
                    <select @bind="ProveedorId" class="w-full rounded-lg border border-slate-300 p-2 text-sm">
                        <option value="0">Seleccione un proveedor</option>
                        @foreach (var proveedor in Proveedores) { <option value="@proveedor.Id">@proveedor.Name</option> }
                    </select>
                </div>
                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-700">Observación</label>
                    <input @bind="Observacion" class="w-full rounded-lg border border-slate-300 p-2 text-sm" placeholder="Referencia, condiciones o nota" />
                </div>
            </div>

            <div class="mt-7 flex items-center justify-between">
                <h2 class="font-bold text-slate-800">Productos</h2>
                <button type="button" @onclick="AgregarLinea" class="rounded-lg border border-blue-200 bg-blue-50 px-3 py-2 text-sm font-medium text-blue-700"><i class="bi bi-plus-lg"></i> Agregar línea</button>
            </div>
            <div class="mt-3 overflow-x-auto border border-slate-200 rounded-lg">
                <table class="w-full text-left text-sm">
                    <thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="p-3">Producto / SKU</th><th class="p-3 w-28">Cantidad</th><th class="p-3 w-36">Costo unitario</th><th class="p-3 w-32">Descuento</th><th class="p-3 w-32">Impuesto</th><th class="p-3 w-24"></th></tr></thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var linea in Lineas)
                        {
                            <tr>
                                <td class="p-3"><select @bind="linea.ProductoVarianteId" class="w-full rounded border border-slate-300 p-2"><option value="0">Seleccione una variante</option>@foreach (var producto in Productos) { <option value="@producto.Id">@producto.Nombre — @producto.Sku</option> }</select></td>
                                <td class="p-3"><input @bind="linea.Cantidad" type="number" min="1" step="1" class="w-full rounded border border-slate-300 p-2" /></td>
                                <td class="p-3"><input @bind="linea.CostoUnitario" type="number" min="0" step="0.01" class="w-full rounded border border-slate-300 p-2" /></td>
                                <td class="p-3"><input @bind="linea.Descuento" type="number" min="0" step="0.01" class="w-full rounded border border-slate-300 p-2" /></td>
                                <td class="p-3"><input @bind="linea.Impuesto" type="number" min="0" step="0.01" class="w-full rounded border border-slate-300 p-2" /></td>
                                <td class="p-3 text-right"><button type="button" @onclick="() => EliminarLinea(linea)" class="text-red-600 hover:text-red-800" title="Eliminar"><i class="bi bi-trash"></i></button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mt-6 flex justify-end gap-3"><a href="/inventario/compras" class="rounded-lg border border-slate-300 px-4 py-2 text-sm text-slate-700">Cancelar</a><button @onclick="Guardar" disabled="@Guardando" class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white disabled:opacity-60">@(Guardando ? "Guardando..." : "Crear orden")</button></div>
        }
    </div>
</div>
