@page "/inventario/compras/{Id:int}/calidad"
@using ERP.DATA.Services.InventarioService.OrdenesDeCompra
@using ERP.DATA.Services.InventarioService.RecepcionService
@using ERP.DATA.Services.InventarioService.ControlCalidad
@inject OrdenesDeCompraManager Ordenes
@inject RecepcionCompraManager Recepciones
@inject ControlCalidadManager Calidad
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Control de calidad</PageTitle>
<div class="p-6 bg-slate-50 min-h-screen max-w-6xl">
    <a href="/inventario/compras/@Id" class="text-sm text-slate-500 hover:text-blue-600"><i class="bi bi-arrow-left"></i> Volver a la orden</a>
    <h1 class="mt-3 text-2xl font-bold text-slate-800">Control de calidad</h1>
    <p class="mt-1 text-sm text-slate-500">Define las unidades aprobadas y rechazadas antes de finalizar la compra.</p>
    @if (!string.IsNullOrWhiteSpace(Error)) { <div class="mt-5 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">@Error</div> }
    @if (Cargando) { <div class="mt-8 text-slate-500">Cargando recepción...</div> }
    else if (Recepcion is null) { <div class="mt-8 rounded-lg border border-amber-200 bg-amber-50 p-4 text-amber-800">Primero debes registrar la recepción física de esta orden.</div> }
    else if (YaExiste) { <div class="mt-8 rounded-lg border border-blue-200 bg-blue-50 p-4 text-blue-800">Esta orden ya tiene un control de calidad. Consulta el detalle de la orden.</div> }
    else
    {
        <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <label class="mb-1 block text-sm font-medium">Observaciones generales</label><textarea @bind="Observaciones" class="w-full rounded-lg border border-slate-300 p-2 text-sm" rows="2" placeholder="Resultado de la inspección"></textarea>
            <div class="mt-6 overflow-x-auto rounded-lg border border-slate-200"><table class="w-full text-sm"><thead class="bg-slate-50 text-left text-xs uppercase text-slate-500"><tr><th class="p-3">Producto</th><th class="p-3 text-right">Recibido</th><th class="p-3 w-36">Aprobado</th><th class="p-3 w-36">Rechazado</th><th class="p-3">Motivo del rechazo</th></tr></thead><tbody class="divide-y divide-slate-100">@foreach (var linea in Lineas) { <tr><td class="p-3 font-medium">@linea.Nombre <span class="block text-xs font-normal text-slate-500">@linea.Sku</span></td><td class="p-3 text-right">@linea.Recibida</td><td class="p-3"><input @bind="linea.Aprobada" type="number" min="0" max="@linea.Recibida" step="1" class="w-full rounded border border-slate-300 p-2" /></td><td class="p-3"><input @bind="linea.Rechazada" type="number" min="0" max="@linea.Recibida" step="1" class="w-full rounded border border-slate-300 p-2" /></td><td class="p-3"><input @bind="linea.Motivo" class="w-full rounded border border-slate-300 p-2" placeholder="Obligatorio si rechaza" /></td></tr> }</tbody></table></div>
            <div class="mt-6 flex justify-end gap-3"><a href="/inventario/compras/@Id" class="rounded-lg border border-slate-300 px-4 py-2 text-sm">Cancelar</a><button @onclick="Guardar" disabled="@Guardando" class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white disabled:opacity-60">@(Guardando ? "Guardando..." : "Registrar control de calidad")</button></div>
        </div>
    }
</div>
