@page "/auditorias/{Id:int}"
@using ERP.TRAN.CrossLayers.API.Inventario.Audit.Enums
@using ERP.TRAN.CrossLayers.API.Inventario.Audit.Responses
@using ERP.TRAN.CrossLayers.API.Inventario.Auditorias.Enums
@using ERP.TRAN.CrossLayers.Core.Utilities.Base.Enums
@rendermode InteractiveServer

<div class="container-fluid py-4 bg-light min-vh-100">
    @if (_loading)
    {
        <div class="d-flex justify-content-center align-items-center position-fixed start-0 top-0 w-100 h-100 bg-white bg-opacity-75" style="z-index: 1050;">
            <div class="text-center">
                <div class="spinner-border text-primary mb-2" role="status"></div>
                <div class="text-muted small fw-medium">Procesando datos de auditoría...</div>
            </div>
        </div>
    }
    else if (_audit == null)
    {
        <div class="alert alert-warning shadow-sm d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-4"></i>
            <div>
                <h6 class="alert-heading mb-0 fw-bold">Auditoría no encontrada</h6>
                <small>El identificador de control no corresponde a ningún registro activo.</small>
            </div>
            <a href="/auditorias" class="btn btn-warning btn-sm ms-auto">Volver al listado</a>
        </div>
    }
    else
    {
        @* HEADER DE CONTROL GENERAL *@
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge bg-dark text-white px-2 py-1 font-monospace">ID: #@_audit.Id</span>
                    <span class="badge @_GetStatusClass(_audit.StatusDisplay) border px-2 py-1">
                        <i class="bi bi-circle-fill me-1 small"></i> @_audit.StatusDisplay
                    </span>
                    <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">@_audit.TypeDisplay</span>
                </div>
                <h3 class="fw-bold tracking-tight mb-0">Control de Existencias</h3>
                <small class="text-muted">
                    <i class="bi bi-geo-alt me-1"></i>Bodega: <strong>@(_audit.WarehouseName ?? "Todas")</strong> · 
                    <i class="bi bi-tags me-1"></i>Categoría: <strong>@(_audit.CategoryName ?? "Todas")</strong>
                </small>
            </div>
            <div class="d-flex gap-2">
                @if (!AuditIsClosed)
                {
                    <button class="btn btn-success btn-sm shadow-sm px-3" @onclick="OpenCloseAuditModal">
                        <i class="bi bi-check2-circle me-1"></i> Cerrar auditoría
                    </button>
                }
                <a href="/auditorias" class="btn btn-white btn-sm border shadow-sm px-3">
                    <i class="bi bi-arrow-left me-1"></i> Volver
                </a>
            </div>
        </div>

        @* SECCIÓN DE MÉTRICAS / KPIS DE CONTEO *@
        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="p-3 bg-white border rounded shadow-sm">
                    <span class="text-muted text-uppercase fs-7 tracking-wider d-block mb-1">Esperado</span>
                    <div class="d-flex align-items-baseline gap-2">
                        <span class="fs-3 fw-bold text-dark">@_audit.TotalExpectedUnits</span>
                        <span class="text-muted small">uds</span>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="p-3 bg-white border rounded shadow-sm">
                    <span class="text-muted text-uppercase fs-7 tracking-wider d-block mb-1">Contado</span>
                    <div class="d-flex align-items-baseline gap-2">
                        <span class="fs-3 fw-bold text-primary">@_audit.TotalCountedUnits</span>
                        <span class="text-muted small">(@_porcentajeConteo%)</span>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="p-3 bg-white border rounded shadow-sm border-start border-success border-3">
                    <span class="text-success text-uppercase fs-7 tracking-wider d-block mb-1">Coincidencias</span>
                    <span class="fs-3 fw-bold text-success">@_audit.TotalMatches</span>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="p-3 bg-white border rounded shadow-sm border-start border-danger border-3">
                    <span class="text-danger text-uppercase fs-7 tracking-wider d-block mb-1">Faltantes</span>
                    <span class="fs-3 fw-bold text-danger">@_audit.TotalMissing</span>
                </div>
            </div>
        </div>

        @* ÁREA DE TRABAJO EN DOS COLUMNAS *@
        <div class="row g-4">
            
            @* COLUMNA IZQUIERDA (8) - REGISTRO OPERATIVO Y LISTADO *@
            <div class="col-lg-8">
                
                @* PANEL DE CAPTURA RÁPIDA *@
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-qr-code-scan me-2 text-primary"></i>Estación de Escaneo</h6>
                        <span class="badge bg-light text-dark border small">Modo: Pistola / Manual</span>
                    </div>
                    <div class="card-body p-3 bg-light-subtle">
                        <div class="row g-2">
                            <div class="col-md-7">
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-barcode text-muted"></i></span>
                                    <input type="text" class="form-control border-start-0 ps-0" 
                                           placeholder="Ingrese o pistolee Serial / SKU..." 
                                           disabled="@AuditIsClosed"
                                           @bind="_scanInput" @bind:event="oninput" @onkeyup="HandleScanKeyUp" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <select class="form-select" @bind="_physicalWarehouseId">
                                    <option value="@Id">Bodega Actual</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button class="btn btn-primary w-100 fw-medium" @onclick="ProcessScan" disabled="@AuditIsClosed">
                                    <i class="bi bi-plus-lg"></i> Validar
                                </button>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(_feedbackMessage))
                        {
                            <div class="alert @_feedbackClass border-0 small p-2 mt-2 mb-0 d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-info-circle-fill me-2"></i>@_feedbackMessage</span>
                                <button type="button" class="btn-close small" style="font-size: 0.65rem;" @onclick="() => _feedbackMessage = null"></button>
                            </div>
                        }
                    </div>
                </div>

                @* TABLA PRINCIPAL DE CONTROL DE UNIDADES *@
                <div class="card shadow-sm border-0 overflow-hidden">
                    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold text-secondary">Unidades en Conciliación (@_unidades.Count)</h6>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-white border" @onclick="TriggerAddSurplusModal" disabled="@AuditIsClosed">
                                <i class="bi bi-plus-circle text-warning me-1"></i> Reportar Sobrante
                            </button>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-uppercase fs-7 tracking-wider border-bottom text-muted">
                                <tr>
                                    <th scope="col" class="ps-4">Identificador / Serial</th>
                                    <th scope="col">Artículo / Producto</th>
                                    <th scope="col">Ubicación Reg.</th>
                                    <th scope="col" class="text-center">Estado Conteo</th>
                                    <th scope="col" class="pe-4 text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody class="border-top-0">
                                @foreach (var u in _unidades)
                                {
                                    <tr class="@(u.StatusDisplay == UnitProductAuditStatus.ExcessProduct.GetDisplayName() ? "table-warning-subtle" : "")">
                                        <td class="ps-4">
                                            <code class="text-dark fw-bold font-monospace">@u.Serial</code>
                                            
                                            @* 🔥 ADICIÓN: INDICADORES VISUALES DE AJUSTES REALIZADOS EN LA FILA *@
                                            <div class="mt-1 d-flex gap-1 flex-wrap">
                                                @if (!string.IsNullOrEmpty(u.UbicacionFisica))
                                                {
                                                    <span class="badge bg-info-subtle text-info custom-mini-badge" title="Ubicación: @u.UbicacionFisica">
                                                        <i class="bi bi-pin-map-fill"></i> @u.UbicacionFisica
                                                    </span>
                                                }
                                                @if (!string.IsNullOrEmpty(u.Observaciones))
                                                {
                                                    <span class="badge bg-secondary-subtle text-dark custom-mini-badge" title="Obs: @u.Observaciones">
                                                        <i class="bi bi-chat-left-text-fill text-muted"></i> Con Notas
                                                    </span>
                                                }
                                                @if (u.RequiereAccionCorrectiva)
                                                {
                                                    <span class="badge bg-danger-subtle text-danger custom-mini-badge animate-pulse" title="Requiere Acción Correctiva">
                                                        <i class="bi bi-exclamation-octagon-fill"></i> Acción Requerida
                                                    </span>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <span class="fw-semibold text-dark d-block">@(u.ProductoName ?? "Sobrante Desconocido")</span>
                                            @if (!string.IsNullOrEmpty(u.EstadoFisico))
                                            {
                                                <small class="text-muted d-block font-italic fs-7">Físico: @u.EstadoFisico</small>
                                            }
                                        </td>
                                        <td>
                                            <span class="text-muted small"><i class="bi bi-building me-1"></i>@(u.BodegaName ?? "—")</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge @_GetStatusClass(u.StatusDisplay) border px-2 py-1">
                                                @u.StatusDisplay
                                            </span>
                                        </td>
                                        <td class="pe-4 text-end">
                                            <button class="btn btn-light btn-sm border shadow-sm px-2" @onclick="() => OpenEditUnitModal(u)" disabled="@AuditIsClosed">
                                                <i class="bi bi-pencil-square text-primary me-1"></i> Ajustar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            @* COLUMNA DERECHA (4) - TRAZABILIDAD GENERAL *@
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 mb-4 bg-white">
                    <div class="card-header bg-white border-bottom py-3">
                        <h6 class="mb-0 fw-bold text-secondary">Trazabilidad Interna</h6>
                    </div>
                    <div class="card-body p-3 small text-dark">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Inicio de Auditoría:</span>
                            <span class="fw-medium">@_audit.StartDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Diferencias Locación:</span>
                            <span class="fw-bold text-warning">@_audit.TotalLocationDifferences uds</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Diferencias Estado:</span>
                            <span class="fw-bold text-info">@_audit.TotalStatusDifferences uds</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Sobrantes (Excesos):</span>
                            <span class="fw-bold text-purple">@_audit.TotalSurplus uds</span>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(_audit.Observations))
                        {
                            <hr class="my-2 border-light" />
                            <div class="bg-light p-2 rounded text-muted fs-7">
                                <strong>Directriz Inicial:</strong> @_audit.Observations
                            </div>
                        }
                    </div>
                </div>

                @if (_audit.TotalMissing > 0 || _audit.TotalLocationDifferences > 0)
                {
                    <div class="alert alert-warning border-0 shadow-sm p-3">
                        <h6 class="fw-bold text-warning-emphasis"><i class="bi bi-shield-exclamation me-2"></i>Discrepancias Detectadas</h6>
                        <p class="mb-0 small text-dark-emphasis">
                            Se registran descuadres de stock. Se recomienda revisar los motivos físicos antes de procesar el cierre.
                        </p>
                    </div>
                }
            </div>
        </div>
    }
</div>

@* MODAL DE AJUSTE AVANZADO DE UNIDAD *@
@if (_showEditModal && _selectedUnit != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-dark text-white">
                    <h6 class="modal-title fw-bold">Modificar Estado Unitario</h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showEditModal = false"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Serial / Referencia</label>
                        <input type="text" class="form-control bg-light font-monospace" value="@_selectedUnit.Serial" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Ubicación Física Real</label>
                        <input type="text" class="form-control" @bind="_editForm.UbicacionFisica" placeholder="Pasillo, Estante, Locker..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Estado Físico del Producto</label>
                        <input type="text" class="form-control" @bind="_editForm.EstadoFisico" placeholder="Ej: Caja maltratada, Óptimo, Abierto..." />
                    </div>
                    @* Colocar dentro del modal body de AuditoriaDetalle.razor *@
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Estado del Conteo / Conciliación</label>
                        <select class="form-select fw-semibold" @bind="_editForm.Status">
                            @foreach (UnitProductAuditStatus statusValue in Enum.GetValues(typeof(UnitProductAuditStatus)))
                            {
                                <option value="@statusValue">@statusValue.GetDisplayName()</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Motivo de la Diferencia</label>
                        <textarea class="form-control" rows="2" @bind="_editForm.MotivoDiferencia" placeholder="¿Por qué no coincide?"></textarea>
                    </div>
                    <div class="form-check form-switch p-3 bg-light rounded mb-0">
                        <input class="form-check-input ms-0 me-2" type="checkbox" role="switch" id="correctiveSwitch" @bind="_editForm.RequiereAccionCorrectiva" />
                        <label class="form-check-label fw-semibold text-dark small" for="correctiveSwitch">¿Requiere Acción Correctiva?</label>
                    </div>
                </div>
                <div class="modal-footer bg-light p-2">
                    <button type="button" class="btn btn-white btn-sm border" @onclick="() => _showEditModal = false">Cancelar</button>
                    <button type="button" class="btn btn-primary btn-sm px-3" @onclick="SaveUnitProductAudit">Guardar Cambios</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showSurplusModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-warning-subtle">
                    <h6 class="modal-title fw-bold text-warning-emphasis">Registrar Sobrante</h6>
                    <button type="button" class="btn-close" @onclick="() => _showSurplusModal = false"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Serial / Codigo encontrado</label>
                        <input type="text" class="form-control font-monospace" @bind="_surplusForm.Code" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Linea de producto</label>
                        <select class="form-select" value="@_surplusForm.ProductId" @onchange="OnSurplusProductChanged">
                            <option value="0">Seleccione producto...</option>
                            @foreach (var p in _productos)
                            {
                                <option value="@p.Id">@p.Nombre (@p.Codigo)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Variante</label>
                        <select class="form-select" @bind="_surplusForm.ProductoVariantId" disabled="@(!_surplusVariants.Any())">
                            <option value="">Seleccione variante...</option>
                            @foreach (var v in _surplusVariants)
                            {
                                <option value="@v.Id">@v.CodigoVariante @(string.IsNullOrWhiteSpace(v.Atributos) ? "" : $" - {v.Atributos}")</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Bodega fisica</label>
                        <input type="number" class="form-control" @bind="_surplusForm.PhysicalWarehouseId" />
                    </div>
                    <div class="mb-0">
                        <label class="form-label small fw-bold text-muted">Observaciones</label>
                        <textarea class="form-control" rows="2" @bind="_surplusForm.Observations"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light p-2">
                    <button type="button" class="btn btn-white btn-sm border" @onclick="() => _showSurplusModal = false">Cancelar</button>
                    <button type="button" class="btn btn-warning btn-sm px-3" @onclick="SaveSurplusUnit" disabled="@_savingSurplus">
                        @if (_savingSurplus)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Registrar sobrante
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showCloseModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-success text-white">
                    <h6 class="modal-title fw-bold">Cerrar Auditoria</h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showCloseModal = false"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="alert alert-warning small">
                        Al cerrar la auditoria se recalculan los totales finales y ya no se podran registrar escaneos, sobrantes ni ajustes.
                    </div>
                    <label class="form-label small fw-bold text-muted">Conclusiones del supervisor</label>
                    <textarea class="form-control" rows="4" @bind="_closeForm.Conclusions" placeholder="Resumen de diferencias, acciones tomadas o pendientes..."></textarea>
                </div>
                <div class="modal-footer bg-light p-2">
                    <button type="button" class="btn btn-white btn-sm border" @onclick="() => _showCloseModal = false">Cancelar</button>
                    <button type="button" class="btn btn-success btn-sm px-3" @onclick="CloseAudit" disabled="@_closingAudit">
                        @if (_closingAudit)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Confirmar cierre
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .custom-mini-badge {
        font-size: 0.65rem !important;
        padding: 2px 6px !important;
        border-radius: 4px;
        font-weight: 500;
    }
    .animate-pulse {
        animation: pulse-danger 2s infinite;
    }
    @@keyframes pulse-danger {
        0% { opacity: 0.7; }
        50% { opacity: 1; }
        100% { opacity: 0.7; }
    }
</style>
