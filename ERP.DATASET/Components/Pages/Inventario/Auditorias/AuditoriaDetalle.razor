@page "/inventario/auditorias/{Id:int}"
@using ERP.TRAN.CrossLayers.API.Inventario.Audit.Enums
@rendermode InteractiveServer
<div class="container-fluid mt-3">
    <!-- Encabezado y Acciones Principales -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0">
                <i class="bi bi-clipboard-check me-2"></i>Auditoría #@Id
            </h3>
            @if (_audit != null)
            {
                <span class="text-muted">Bodega ID: @_audit.WarehouseId</span>
            }
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary" @onclick='() => Navigation.NavigateTo("/inventario/auditorias")'>
                <i class="bi bi-arrow-left me-1"></i> Volver
            </button>

            @if (_audit != null && !AuditIsClosed)
            {
                <button class="btn btn-warning" @onclick="TriggerAddSurplusModal">
                    <i class="bi bi-plus-circle me-1"></i> Identificar Sobrante
                </button>
                <button class="btn btn-outline-dark" @onclick="OpenRejectAuditModal">
                    <i class="bi bi-x-octagon me-1"></i> Rechazar Auditoría
                </button>
                <button class="btn btn-danger" @onclick="OpenCloseAuditModal">
                    <i class="bi bi-lock me-1"></i> Cerrar Auditoría
                </button>
            }
        </div>
    </div>

    <!-- Mensaje de Feedback -->
    @if (!string.IsNullOrEmpty(_feedbackMessage))
    {
        <div class="alert @_feedbackClass alert-dismissible fade show" role="alert">
            @_feedbackMessage
            <button type="button" class="btn-close" @onclick="() => _feedbackMessage = null"></button>
        </div>
    }

    <!-- Indicador de Carga -->
    @if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-2 text-muted">Cargando detalles de la auditoría...</p>
        </div>
    }
    else if (_audit != null)
    {
        <!-- Información General y Progreso -->
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="card-subtitle mb-2 text-muted">Estado Actual</h6>
                        <span class="badge @_GetStatusClass(_audit.Status) fs-6">
                            @_audit.Status
                        </span>
                    </div>
                </div>
            </div>
            <div class="col-md-8">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="card-subtitle mb-2 text-muted">
                            Progreso del Conteo (@_audit.TotalCounted / @_audit.TotalExpected)
                        </h6>
                        <div class="progress mb-2" style="height: 10px;">
                            <div class="progress-bar bg-success" role="progressbar"
                                 style="width: @(_audit.CompletionPercent)%"></div>
                        </div>
                        <div class="d-flex gap-3 small text-muted">
                            <span><i class="bi bi-check-circle text-success me-1"></i>Encontradas: @_audit.TotalFound</span>
                            <span><i class="bi bi-question-circle text-warning me-1"></i>Faltantes: @_audit.TotalNotFound</span>
                            <span><i class="bi bi-plus-circle text-info me-1"></i>Sobrantes: @_audit.TotalSurplus</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Barra de Escaneo de Códigos -->
        @if (!AuditIsClosed)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title mb-3">
                        <i class="bi bi-qr-code-scan me-2"></i>Escaneo de Unidades
                    </h5>
                    <div class="input-group">
                        <input type="text" 
                               class="form-control form-control-lg" 
                               placeholder="Escanee o ingrese el serial/código de barras..." 
                               @bind="_scanInput" 
                               @bind:event="oninput"
                               @onkeyup="HandleScanKeyUp" />
                        <button class="btn btn-primary px-4" @onclick="ProcessScan">
                            <i class="bi bi-search me-1"></i> Procesar
                        </button>
                    </div>
                </div>
            </div>
        }

        <!-- Tabla de Unidades auditadas (conteo ciego: solo unidades ya escaneadas) -->
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="card-title mb-0">Unidades Escaneadas (@_unidades.Count de @_audit.TotalExpected esperadas)</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Serial / Código</th>
                            <th>Producto</th>
                            <th>Ubicación Física</th>
                            <th>Estado</th>
                            <th>Observaciones</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_unidades.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    Aún no se ha escaneado ninguna unidad en esta auditoría.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var unit in _unidades)
                            {
                                <tr>
                                    <td class="fw-bold">@unit.Serial</td>
                                    <td>@(string.IsNullOrEmpty(unit.ProductoName) ? "Sin identificar" : unit.ProductoName)</td>
                                    <td>@(string.IsNullOrEmpty(unit.UbicacionFisica) ? "-" : unit.UbicacionFisica)</td>
                                    <td>
                                        <span class="badge @_GetStatusClass(unit.StatusDisplay)">
                                            @unit.StatusDisplay
                                        </span>
                                    </td>
                                    <td><small class="text-muted">@unit.Observaciones</small></td>
                                    <td class="text-end">
                                        @if (!AuditIsClosed)
                                        {
                                            <button class="btn btn-sm btn-outline-primary me-1" 
                                                    @onclick="() => OpenEditUnitModal(unit)" 
                                                    title="Editar estado">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" 
                                                    @onclick="() => OpenLossModal(unit)" 
                                                    title="Enviar a pérdida">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Modal: Editar Unidad -->
@if (_showEditModal && _selectedUnit != null)
{
    <div class="modal fade show d-block tab-index-1 bg-dark bg-opacity-50" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Editar Unidad: @_selectedUnit.Serial</h5>
                    <button type="button" class="btn-close" @onclick="() => _showEditModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Estado de la Unidad</label>
                        <InputSelect class="form-select" @bind-Value="_editForm.Status">
                            @foreach (UnitProductAuditStatus status in Enum.GetValues(typeof(UnitProductAuditStatus)))
                            {
                                <option value="@status">@status.ToString()</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ubicación Física</label>
                        <input type="text" class="form-control" @bind="_editForm.UbicacionFisica" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Observaciones</label>
                        <textarea class="form-control" rows="3" @bind="_editForm.Observaciones"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => _showEditModal = false">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveUnitProductAudit">Guardar Cambios</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Identificar Sobrante (completa uno detectado por escaneo, no crea desde cero) -->
@if (_showSurplusModal)
{
    <div class="modal fade show d-block tab-index-1 bg-dark bg-opacity-50" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Identificar Unidad Sobrante</h5>
                    <button type="button" class="btn-close" @onclick="() => _showSurplusModal = false"></button>
                </div>
                <div class="modal-body">
                    @if (_pendingSurplusUnits.Count == 0)
                    {
                        <p class="text-muted mb-0">
                            No hay sobrantes pendientes de identificar. Los sobrantes se registran automáticamente al escanear un código que no pertenece a esta auditoría.
                        </p>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">Código / Serial detectado</label>
                            <select class="form-select" @bind="_surplusForm.Code">
                                <option value="">-- Seleccionar sobrante pendiente --</option>
                                @foreach (var pending in _pendingSurplusUnits)
                                {
                                    <option value="@pending.Serial">@pending.Serial</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Producto</label>
                            <select class="form-select" @onchange="OnSurplusProductChanged">
                                <option value="0">-- Seleccionar Producto --</option>
                                @foreach (var prod in _productos)
                                {
                                    <option value="@prod.Id">@prod.Nombre</option>
                                }
                            </select>
                        </div>
                        @if (_surplusVariants.Count > 0)
                        {
                            <div class="mb-3">
                                <label class="form-label">Variante</label>
                                <InputSelect class="form-select" @bind-Value="_surplusForm.ProductoVariantId">
                                    <option value="0">-- Seleccionar Variante --</option>
                                    @foreach (var v in _surplusVariants)
                                    {
                                        <option value="@v.Id">@v.CodigoVariante - @v.CodigoBarras</option>
                                    }
                                </InputSelect>
                            </div>
                        }
                        <div class="mb-3">
                            <label class="form-label">Observaciones</label>
                            <textarea class="form-control" rows="2" @bind="_surplusForm.Observations"></textarea>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => _showSurplusModal = false">Cancelar</button>
                    <button type="button" class="btn btn-warning" @onclick="SaveSurplusUnit"
                            disabled="@(_savingSurplus || _pendingSurplusUnits.Count == 0)">
                        @if (_savingSurplus)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Guardar Identificación
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Enviar a Pérdidas -->
@if (_showLossModal && _unitToLoss != null)
{
    <div class="modal fade show d-block tab-index-1 bg-dark bg-opacity-50" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Confirmar Envío a Pérdidas</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showLossModal = false"></button>
                </div>
                <div class="modal-body">
                    <p>¿Está seguro de enviar la unidad <strong>@_unitToLoss.Serial</strong> (@_unitToLoss.ProductoName) a la bodega de pérdidas?</p>
                    <div class="mb-3">
                        <label class="form-label">Motivo / Observaciones</label>
                        <textarea class="form-control" rows="3" @bind="_lossObservations" placeholder="Ingrese el motivo del envío a pérdidas..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => _showLossModal = false">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmSendToLoss" disabled="@_sendingLoss">
                        @if (_sendingLoss)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Confirmar Pérdida
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Cerrar Auditoría -->
@if (_showCloseModal)
{
    <div class="modal fade show d-block tab-index-1 bg-dark bg-opacity-50" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Cerrar Auditoría #@Id</h5>
                    <button type="button" class="btn-close" @onclick="() => _showCloseModal = false"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted">Al cerrar la auditoría no se podrán registrar más escaneos ni realizar modificaciones sobre las unidades auditadas.</p>
                    <div class="mb-3">
                        <label class="form-label">Conclusiones de la Auditoría</label>
                        <textarea class="form-control" rows="4" @bind="_closeForm.Conclusions" placeholder="Escriba las observaciones o conclusiones finales..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => _showCloseModal = false">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="CloseAudit" disabled="@_closingAudit">
                        @if (_closingAudit)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Finalizar y Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Rechazar Auditoría -->
@if (_showRejectModal)
{
    <div class="modal fade show d-block tab-index-1 bg-dark bg-opacity-50" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">Rechazar Auditoría #@Id</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showRejectModal = false"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted">
                        Al rechazar la auditoría no se aplicará ningún ajuste de inventario: todas las unidades bloqueadas regresarán a su estado original.
                    </p>
                    <div class="mb-3">
                        <label class="form-label">Motivo del Rechazo</label>
                        <textarea class="form-control" rows="4" @bind="_rejectForm.Reason" placeholder="Explique por qué se rechaza esta auditoría..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => _showRejectModal = false">Cancelar</button>
                    <button type="button" class="btn btn-dark" @onclick="ConfirmRejectAudit" disabled="@_rejectingAudit">
                        @if (_rejectingAudit)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Confirmar Rechazo
                    </button>
                </div>
            </div>
        </div>
    </div>
}