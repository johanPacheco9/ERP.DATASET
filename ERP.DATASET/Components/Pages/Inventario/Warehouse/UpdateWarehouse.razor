@page "/bodegas/editar/{Id:int}"
@using ERP.TRAN.CrossLayers.API.Inventario.Warehouse.Enums
@using ERP.TRAN.CrossLayers.Core.Utilities.Base.Enums
@attribute [Authorize(Roles = AppPermissions.Policies.AdminOnly)]
@rendermode InteractiveServer

<div class="max-w-3xl mx-auto px-4 py-8">
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Actualizar Bodega</h1>
            <p class="text-sm text-gray-500 mt-1">Modifica los detalles operativos y de capacidad de la bodega.</p>
        </div>
        <NavLink href="/bodegas"
                 class="inline-flex items-center px-3 py-1.5 border border-gray-300 shadow-sm text-xs font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 transition-colors">
            Volver
        </NavLink>
    </div>

    @if (!string.IsNullOrEmpty(_mensaje))
    {
        <div
            class="mb-6 p-4 rounded-lg text-sm font-medium @(_mensaje.Contains("correctamente") ? "bg-emerald-50 text-emerald-800 border border-emerald-200" : "bg-rose-50 text-rose-800 border border-rose-200")">
            @_mensaje
        </div>
    }

    @if (_bodega == null && string.IsNullOrEmpty(_mensaje))
    {
        <div class="flex justify-center items-center py-12">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600"></div>
        </div>
    }
    else if (_bodega != null)
    {
        <div class="bg-white shadow-sm border border-gray-200 rounded-xl p-6">
            <EditForm Model="_updateForm" OnValidSubmit="Update">
                <DataAnnotationsValidator/>

                <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                    <div class="sm:col-span-2">
                        <label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Nombre de
                            la bodega</label>
                        <InputText
                            class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm py-2 px-3 border"
                            @bind-Value="_updateForm.Name"/>
                        <ValidationMessage For="() => _updateForm.Name" class="text-rose-600 text-xs mt-1"/>
                    </div>

                    <div>
                        <label
                            class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Código</label>
                        <InputText
                            class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm py-2 px-3 border"
                            @bind-Value="_updateForm.Code"/>
                        <ValidationMessage For="() => _updateForm.Code" class="text-rose-600 text-xs mt-1"/>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Capacidad
                            Máxima</label>
                        <InputNumber
                            class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm py-2 px-3 border"
                            @bind-Value="_updateForm.MaxCapacity"/>
                        <ValidationMessage For="() => _updateForm.MaxCapacity" class="text-rose-600 text-xs mt-1"/>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Tipo de
                            Bodega</label>
                        <InputSelect
                            class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm py-2 px-3 border bg-white"
                            @bind-Value="_updateForm.Type">
                            @foreach (var tipo in Enum.GetValues<WarehouseType>())
                            {
                                <option value="@tipo">@tipo.GetDisplayName()</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => _updateForm.Type" class="text-rose-600 text-xs mt-1"/>
                    </div>
                    @* 
    <div>
        <label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Tienda Asociada</label>
        <InputSelect class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm py-2 px-3 border bg-white" @bind-Value="_updateForm.StoreId">
            <option value="">Mantener actual / Seleccionar...</option>
            @foreach (var tienda in _tiendas)
            {
                <option value="@tienda.Id">@tienda.Name</option>
            }
        </InputSelect>
        <ValidationMessage For="() => _updateForm.StoreId" class="text-rose-600 text-xs mt-1" />
    </div>
*@
                    <div class="sm:col-span-2">
                        <label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Ubicación
                            Física</label>
                        <InputText
                            class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm py-2 px-3 border"
                            @bind-Value="_updateForm.Ubication"/>
                        <ValidationMessage For="() => _updateForm.Ubication" class="text-rose-600 text-xs mt-1"/>
                    </div>

                    <div class="sm:col-span-2">
                        <label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Descripción</label>
                        <InputTextArea
                            class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm py-2 px-3 border"
                            rows="3" @bind-Value="_updateForm.Description"/>
                        <ValidationMessage For="() => _updateForm.Description" class="text-rose-600 text-xs mt-1"/>
                    </div>
                </div>

                <div class="mt-8 flex items-center justify-end gap-3 border-t border-gray-100 pt-5">
                    <NavLink href="/warehouses"
                             class="px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 transition-colors">
                        Cancelar
                    </NavLink>
                    <button type="submit" disabled="@_guardando"
                            class="inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors disabled:opacity-50">
                        @if (_guardando)
                        {
                            <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor"
                                        stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor"
                                      d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                        }
                        Guardar Cambios
                    </button>
                </div>
            </EditForm>
        </div>
    }
</div>