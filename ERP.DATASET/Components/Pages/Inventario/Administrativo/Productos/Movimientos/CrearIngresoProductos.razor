@using ERP.DATASET.Components
@rendermode InteractiveServer

<div class="w-100">
    <div class="d-flex align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h4 class="fw-bold mb-1">Nuevo producto</h4>
            <p class="text-muted mb-0">Crea la linea base y define los SKUs que recibiran inventario.</p>
        </div>
        <div class="d-flex gap-2 small">
            <span class="badge @(_paso == 1 ? "bg-primary" : "bg-light text-dark border")">1 Base</span>
            <span class="badge @(_paso == 2 ? "bg-primary" : "bg-light text-dark border")">2 Tipo</span>
            <span class="badge @(_paso == 3 ? "bg-primary" : "bg-light text-dark border")">3 SKUs</span>
            <span class="badge @(_paso == 4 ? "bg-success" : "bg-light text-dark border")">4 Listo</span>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="inv-loading py-4">Procesando...</div>
    }

    @if (_errores.Any())
    {
        <div class="alert alert-danger small">
            <ul class="mb-0">
                @foreach (var error in _errores)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    @if (_paso == 1)
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="inv-card p-4">
                    <EditForm Model="_form" OnValidSubmit="CrearProducto">
                        <DataAnnotationsValidator />
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Codigo base</label>
                                <InputText class="form-control text-uppercase" @bind-Value="_form.Codigo" placeholder="PROD-001" />
                                <ValidationMessage For="@(() => _form.Codigo)" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Nombre</label>
                                <InputText class="form-control" @bind-Value="_form.Nombre" placeholder="Nombre comercial del producto" />
                                <ValidationMessage For="@(() => _form.Nombre)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Categoria</label>
                                <InputSelect class="form-select" @bind-Value="_form.CategoriaIds">
                                    <option value="0">Seleccione categoria...</option>
                                    @foreach (var cat in _categorias ?? [])
                                    {
                                        <option value="@cat.Id">@cat.Nombre</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => _form.CategoriaIds)" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Costo unitario</label>
                                <InputNumber class="form-control" @bind-Value="_form.Costo_Unitario" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Precio venta</label>
                                <InputNumber class="form-control" @bind-Value="_form.Precio_Venta" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Descripcion</label>
                                <InputTextArea class="form-control" rows="2" @bind-Value="_form.Descripcion" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Unidad</label>
                                <InputSelect class="form-select" @bind-Value="_form.Unidad_Medida">
                                    <option value="UND">Unidades</option>
                                    <option value="KG">Kilogramos</option>
                                    <option value="MT">Metros</option>
                                    <option value="LT">Litros</option>
                                </InputSelect>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">IVA</label>
                                <InputNumber class="form-control" @bind-Value="_form.PorcentajeIVA" step="0.01" />
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <div class="form-check mb-2">
                                    <InputCheckbox class="form-check-input" @bind-Value="_form.ExentoIVA" id="exentoIvaProducto" />
                                    <label class="form-check-label" for="exentoIvaProducto">Exento IVA</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Imagen URL</label>
                                <InputText class="form-control" @bind-Value="_form.Imagen_Url" placeholder="https://..." />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Tags</label>
                                <InputText class="form-control" @bind-Value="_form.Tags" placeholder="rotacion, tienda, promo" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <button type="button" class="btn btn-outline-secondary" @onclick="Cerrar">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@_isLoading">
                                Guardar base y continuar
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="inv-card p-3 small text-muted">
                    <strong class="text-dark d-block mb-2">Producto base</strong>
                    <p class="mb-2">La base define nombre, categoria, precios e impuestos. Luego creas uno o varios SKUs.</p>
                    <p class="mb-0">El stock se registra despues, desde ingresos a bodega.</p>
                </div>
            </div>
        </div>
    }

    @if (_paso == 2)
    {
        <div class="row g-3">
            <div class="col-md-6">
                <button type="button" class="inv-card p-4 w-100 text-start border-0" @onclick="CrearVarianteUnica" disabled="@_isLoading">
                    <i class="bi bi-upc-scan fs-3 text-primary"></i>
                    <h5 class="mt-3 mb-2">Producto sin variantes</h5>
                    <p class="text-muted mb-0 small">Se crea un SKU igual al codigo base: @_form.Codigo.</p>
                </button>
            </div>
            <div class="col-md-6">
                <button type="button" class="inv-card p-4 w-100 text-start border-0" @onclick="IrADefinirVariantes">
                    <i class="bi bi-diagram-3 fs-3 text-primary"></i>
                    <h5 class="mt-3 mb-2">Producto con variantes</h5>
                    <p class="text-muted mb-0 small">Define tallas, colores, capacidades u otras referencias.</p>
                </button>
            </div>
        </div>
    }

    @if (_paso == 3)
    {
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="inv-card p-4">
                    <h5 class="fw-semibold mb-3">Nueva variante</h5>
                    <div class="mb-3">
                        <label class="form-label">Sufijo SKU</label>
                        <div class="input-group">
                            <span class="input-group-text">@_form.Codigo-</span>
                            <input type="text" class="form-control text-uppercase" @bind="_nuevaVariante.CodigoSufijo" placeholder="ROJO-M" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Atributos</label>
                        <input type="text" class="form-control" @bind="_nuevaVariante.Atributos" placeholder="Color rojo, talla M" />
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label">Precio venta</label>
                            <input type="number" class="form-control" @bind="_nuevaVariante.Precio_Venta" step="0.01" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Costo unitario</label>
                            <input type="number" class="form-control" @bind="_nuevaVariante.Costo_Unitario" step="0.01" />
                        </div>
                    </div>
                    <div class="mt-3">
                        <label class="form-label">Codigo de barras</label>
                        <input type="text" class="form-control" @bind="_nuevaVariante.Codigo_Barras" />
                    </div>
                    <button class="btn btn-outline-primary w-100 mt-3" @onclick="AgregarVariante" type="button">
                        Agregar variante
                    </button>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="inv-card">
                    <div class="inv-card-header">Variantes (@_variantesTemp.Count)</div>
                    @if (!_variantesTemp.Any())
                    {
                        <div class="inv-empty">Aun no hay variantes.</div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var (variante, index) in _variantesTemp.Select((v, i) => (v, i)))
                            {
                                <div class="list-group-item d-flex justify-content-between gap-2">
                                    <div>
                                        <code>@variante.CodigoVariante</code>
                                        <div class="small text-muted">@variante.Atributos</div>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-link text-danger" @onclick="() => EliminarVariante(index)">Quitar</button>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="d-flex justify-content-between gap-2 mt-3">
                    <button class="btn btn-outline-secondary" @onclick="() => _paso = 2" type="button">Volver</button>
                    <button class="btn btn-success" @onclick="GuardarTodasLasVariantes" disabled="@(!_variantesTemp.Any() || _isLoading)" type="button">
                        Guardar variantes
                    </button>
                </div>
            </div>
        </div>
    }

    @if (_paso == 4)
    {
        <div class="inv-card p-4 text-center">
            <i class="bi bi-check-circle-fill text-success fs-1"></i>
            <h4 class="fw-bold mt-3">Producto listo</h4>
            <p class="text-muted">@_form.Nombre se creo con @_totalSkusCreados SKU(s).</p>
            @if (_skusCreados.Any())
            {
                <div class="d-flex justify-content-center gap-2 flex-wrap mb-3">
                    @foreach (var sku in _skusCreados)
                    {
                        <span class="badge bg-success-subtle text-success border">@sku</span>
                    }
                </div>
            }
            <div class="d-flex justify-content-center gap-2">
                <button class="btn btn-outline-primary" @onclick="Reiniciar" type="button">Crear otro</button>
                <button class="btn btn-primary" @onclick="Cerrar" type="button">Volver al listado</button>
            </div>
        </div>
    }
</div>
