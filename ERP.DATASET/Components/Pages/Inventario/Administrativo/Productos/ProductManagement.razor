 @page "/ProductManagement"
@using System.ComponentModel
@using ERP.DATASET.Components
<BreadCrumb/>
<h3 class="mb-4 text-primary">📦 Panel de Gestión de Productos</h3>

<div class="container">
    <div class="row g-4">
        
        <!-- Card 1: Ingreso de Productos -->
        <div class="col-md-6 col-lg-4">
            <div class="card card-hover h-100 border-primary">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-box-open me-2"></i>Ingreso
                    </h5>
                    <span class="badge bg-light text-primary">Nuevo</span>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-wrapper bg-primary-subtle rounded-circle p-3 me-3">
                            <i class="fas fa-plus-circle fa-2x text-primary"></i>
                        </div>
                        <div>
                            <h6 class="card-title mb-1">Registro de Productos</h6>
                            <p class="text-muted small mb-0">Agregar nuevos productos al sistema</p>
                        </div>
                    </div>
                    <p class="card-text">
                        Crea nuevos registros de productos con toda la información necesaria:
                        código, nombre, categoría, precio, stock y más.
                    </p>
                    <div class="mt-3">
                        <span class="badge bg-light text-dark me-2">
                            <i class="fas fa-hashtag me-1"></i>SKU
                        </span>
                        <span class="badge bg-light text-dark me-2">
                            <i class="fas fa-tag me-1"></i>Precio
                        </span>
                        <span class="badge bg-light text-dark">
                            <i class="fas fa-layer-group me-1"></i>Stock
                        </span>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-top-0">
                    <a href="/ProductosDashboard" class="btn btn-primary w-100">
                        <i class="fas fa-arrow-right me-2"></i>Ingresar Productos
                    </a>
                </div>
            </div>
        </div>

        <!-- Card 2: Inventario -->
        <div class="col-md-6 col-lg-4">
            <div class="card card-hover h-100 border-success">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-warehouse me-2"></i>Inventario
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-wrapper bg-success-subtle rounded-circle p-3 me-3">
                            <i class="fas fa-clipboard-list fa-2x text-success"></i>
                        </div>
                        <div>
                            <h6 class="card-title mb-1">Control de Stock</h6>
                            <p class="text-muted small mb-0">Gestiona tu inventario en tiempo real</p>
                        </div>
                    </div>
                    <p class="card-text">
                        Consulta, actualiza y controla el stock de todos tus productos.
                        Alertas automáticas de bajo inventario.
                    </p>
                    <div class="progress mb-2" style="height: 8px;">
                        <div class="progress-bar bg-success" style="width: 75%"></div>
                    </div>
                    <div class="d-flex justify-content-between small text-muted">
                        <span>Disponibilidad: 75%</span>
                        <span><i class="fas fa-chart-line me-1"></i>Estable</span>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-top-0">
                    <a href="/Inventario" class="btn btn-success w-100">
                        <i class="fas fa-chart-bar me-2"></i>Ver Inventario
                    </a>
                </div>
            </div>
        </div>

        <!-- Card 3: Análisis -->
        <div class="col-md-6 col-lg-4">
            <div class="card card-hover h-100 border-info">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-chart-pie me-2"></i>Análisis
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-wrapper bg-info-subtle rounded-circle p-3 me-3">
                            <i class="fas fa-chart-line fa-2x text-info"></i>
                        </div>
                        <div>
                            <h6 class="card-title mb-1">Reportes & Estadísticas</h6>
                            <p class="text-muted small mb-0">Métricas y análisis de productos</p>
                        </div>
                    </div>
                    <p class="card-text">
                        Genera reportes detallados, análisis de ventas, tendencias y
                        métricas de rendimiento de productos.
                    </p>
                    <div class="row text-center mt-3">
                        <div class="col-4">
                            <div class="display-6 fw-bold text-info">24</div>
                            <small class="text-muted">Vendidos Hoy</small>
                        </div>
                        <div class="col-4 border-start">
                            <div class="display-6 fw-bold text-info">156</div>
                            <small class="text-muted">Este Mes</small>
                        </div>
                        <div class="col-4 border-start">
                            <div class="display-6 fw-bold text-info">89%</div>
                            <small class="text-muted">Disponible</small>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-top-0">
                    <a href="/Analisis" class="btn btn-info w-100 text-white">
                        <i class="fas fa-file-chart-column me-2"></i>Ver Reportes
                    </a>
                </div>
            </div>
        </div>

        <!-- Card 4: Categorías -->
        <div class="col-md-6 col-lg-4">
            <div class="card card-hover h-100 border-warning">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">
                        <i class="fas fa-tags me-2"></i>Categorías
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-wrapper bg-warning-subtle rounded-circle p-3 me-3">
                            <i class="fas fa-sitemap fa-2x text-warning"></i>
                        </div>
                        <div>
                            <h6 class="card-title mb-1">Gestión de Categorías</h6>
                            <p class="text-muted small mb-0">Organiza por categorías y subcategorías</p>
                        </div>
                    </div>
                    <p class="card-text">
                        Crea y gestiona categorías de productos, organiza jerarquías
                        y asigna productos a diferentes grupos.
                    </p>
                    <div class="mt-3">
                        <div class="d-flex align-items-center mb-2">
                            <div class="flex-shrink-0">
                                <span class="badge bg-warning rounded-circle p-2">
                                    <i class="fas fa-microchip"></i>
                                </span>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <small>Electrónica (45 productos)</small>
                            </div>
                        </div>
                        <div class="d-flex align-items-center mb-2">
                            <div class="flex-shrink-0">
                                <span class="badge bg-warning rounded-circle p-2">
                                    <i class="fas fa-tshirt"></i>
                                </span>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <small>Ropa (82 productos)</small>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-top-0">
                    <a href="/Categorias" class="btn btn-warning w-100">
                        <i class="fas fa-folder-tree me-2"></i>Gestionar Categorías
                    </a>
                </div>
            </div>
        </div>

        <!-- Card 5: Proveedores -->
        <div class="col-md-6 col-lg-4">
            <div class="card card-hover h-100 border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-truck me-2"></i>Proveedores
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-wrapper bg-danger-subtle rounded-circle p-3 me-3">
                            <i class="fas fa-handshake fa-2x text-danger"></i>
                        </div>
                        <div>
                            <h6 class="card-title mb-1">Gestión de Proveedores</h6>
                            <p class="text-muted small mb-0">Administra tus proveedores</p>
                        </div>
                    </div>
                    <p class="card-text">
                        Gestiona información de proveedores, contactos, historial
                        de compras y rendimiento de entrega.
                    </p>
                    <div class="alert alert-light border-danger mb-0">
                        <div class="d-flex">
                            <div class="flex-shrink-0">
                                <i class="fas fa-info-circle text-danger"></i>
                            </div>
                            <div class="flex-grow-1 ms-2">
                                <small class="text-muted">
                                    <strong>3 pedidos pendientes</strong> de confirmación
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-top-0">
                    <a href="/Proveedores" class="btn btn-danger w-100">
                        <i class="fas fa-address-book me-2"></i>Ver Proveedores
                    </a>
                </div>
            </div>
        </div>

        <!-- Card 6: Configuración -->
        <div class="col-md-6 col-lg-4">
            <div class="card card-hover h-100 border-secondary">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-cogs me-2"></i>Configuración
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-wrapper bg-secondary-subtle rounded-circle p-3 me-3">
                            <i class="fas fa-sliders-h fa-2x text-secondary"></i>
                        </div>
                        <div>
                            <h6 class="card-title mb-1">Ajustes del Sistema</h6>
                            <p class="text-muted small mb-0">Personaliza tu gestión</p>
                        </div>
                    </div>
                    <p class="card-text">
                        Configura parámetros del sistema, permisos de usuario,
                        plantillas de reportes y preferencias de la aplicación.
                    </p>
                    <div class="list-group list-group-flush small">
                        <div class="list-group-item bg-transparent px-0 py-1">
                            <i class="fas fa-user-shield text-secondary me-2"></i>
                            <span>Permisos de usuario</span>
                        </div>
                        <div class="list-group-item bg-transparent px-0 py-1">
                            <i class="fas fa-file-export text-secondary me-2"></i>
                            <span>Formatos de exportación</span>
                        </div>
                        <div class="list-group-item bg-transparent px-0 py-1">
                            <i class="fas fa-bell text-secondary me-2"></i>
                            <span>Notificaciones y alertas</span>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-top-0">
                    <a href="/Configuracion" class="btn btn-secondary w-100">
                        <i class="fas fa-tools me-2"></i>Configurar Sistema
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Quick Stats -->
<div class="container mt-5">
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="card-subtitle mb-3 text-muted">
                        <i class="fas fa-bolt me-2"></i>Resumen Rápido
                    </h6>
                    <div class="row text-center">
                        <div class="col-md-3 col-6 mb-3">
                            <div class="p-3 bg-primary bg-opacity-10 rounded">
                                <div class="h2 mb-0 text-primary">142</div>
                                <small class="text-muted">Productos Totales</small>
                            </div>
                        </div>
                        <div class="col-md-3 col-6 mb-3">
                            <div class="p-3 bg-success bg-opacity-10 rounded">
                                <div class="h2 mb-0 text-success">24</div>
                                <small class="text-muted">Ventas Hoy</small>
                            </div>
                        </div>
                        <div class="col-md-3 col-6 mb-3">
                            <div class="p-3 bg-warning bg-opacity-10 rounded">
                                <div class="h2 mb-0 text-warning">8</div>
                                <small class="text-muted">Bajo Stock</small>
                            </div>
                        </div>
                        <div class="col-md-3 col-6 mb-3">
                            <div class="p-3 bg-info bg-opacity-10 rounded">
                                <div class="h2 mb-0 text-info">15</div>
                                <small class="text-muted">Proveedores Activos</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    // Puedes agregar lógica aquí si necesitas
    private int productosTotales = 142;
    private int ventasHoy = 24;
    private int bajoStock = 8;
    private int proveedoresActivos = 15;
}

<style>
    /* Estilos personalizados */
    .card-hover {
        transition: all 0.3s ease;
        border: 2px solid transparent;
    }

        .card-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
            border-color: var(--bs-primary);
        }

    .icon-wrapper {
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .card-header {
        border-bottom: 2px solid rgba(0,0,0,0.1);
    }

    .progress {
        border-radius: 10px;
    }

    .progress-bar {
        border-radius: 10px;
    }

    .list-group-item {
        border: none;
    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .display-6 {
            font-size: 1.5rem;
        }

        .icon-wrapper {
            width: 50px;
            height: 50px;
            padding: 0.75rem !important;
        }
    }

    /* Animation for badges */
    .badge {
        transition: all 0.2s ease;
    }

        .badge:hover {
            transform: scale(1.05);
        }

    /* Custom border colors */
    .border-primary-subtle {
        border-color: #cfe2ff !important;
    }

    .border-success-subtle {
        border-color: #d1e7dd !important;
    }

    .border-warning-subtle {
        border-color: #fff3cd !important;
    }

    .border-danger-subtle {
        border-color: #f8d7da !important;
    }

    .border-info-subtle {
        border-color: #cff4fc !important;
    }
</style>