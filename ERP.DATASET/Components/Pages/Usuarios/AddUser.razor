@page "/usuarios/nuevo"
@attribute [Authorize(Roles = AppPermissions.Roles.Admin)]
@rendermode InteractiveServer

<div class="max-w-3xl mx-auto p-4 sm:p-6 space-y-6 mt-4">
    <!-- Header -->
    <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200 flex items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <span class="px-2.5 py-0.5 rounded-full bg-blue-100 text-blue-800 font-semibold text-xs border border-blue-200">
                    Seguridad & Acceso
                </span>
            </div>
            <h1 class="text-2xl font-bold text-slate-800 tracking-tight">Crear Nuevo Usuario</h1>
            <p class="text-xs text-slate-500 mt-0.5">Registre empleados, cajeros o administradores para operar en el ERP.</p>
        </div>
        <a href="/usuarios" class="px-3.5 py-2 rounded-xl text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 transition-colors flex items-center gap-1.5 border border-slate-200">
            <i class="bi bi-arrow-left"></i> Volver al Listado
        </a>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded-xl text-xs flex items-center gap-2 shadow-sm">
            <i class="bi bi-exclamation-triangle-fill text-sm"></i>
            <span>@_errorMessage</span>
        </div>
    }

    <!-- Formulario de Creación -->
    <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-slate-200 space-y-6">
        <form @onsubmit="HandleSubmit" class="space-y-6">
            
            <!-- Bloque Nombres -->
            <div>
                <h3 class="text-xs font-bold text-slate-700 uppercase tracking-wider mb-3 pb-1 border-b border-slate-100 flex items-center gap-1.5">
                    <i class="bi bi-person-fill text-blue-600"></i> Nombres del Usuario
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1.5">
                            Primer Nombre <span class="text-rose-500">*</span>
                        </label>
                        <input type="text" 
                               @bind="_model.PrimerNombre" 
                               required 
                               placeholder="Ej. Carlos"
                               class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1.5">
                            Segundo Nombre <span class="text-slate-400 font-normal">(Opcional)</span>
                        </label>
                        <input type="text" 
                               @bind="_model.SegundoNombre" 
                               placeholder="Ej. Andrés"
                               class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                    </div>
                </div>
            </div>

            <!-- Bloque Apellidos -->
            <div>
                <h3 class="text-xs font-bold text-slate-700 uppercase tracking-wider mb-3 pb-1 border-b border-slate-100 flex items-center gap-1.5">
                    <i class="bi bi-person-badge-fill text-blue-600"></i> Apellidos del Usuario
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1.5">
                            Primer Apellido <span class="text-rose-500">*</span>
                        </label>
                        <input type="text" 
                               @bind="_model.PrimerApellido" 
                               required 
                               placeholder="Ej. Gómez"
                               class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1.5">
                            Segundo Apellido <span class="text-slate-400 font-normal">(Opcional)</span>
                        </label>
                        <input type="text" 
                               @bind="_model.SegundoApellido" 
                               placeholder="Ej. Pérez"
                               class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                    </div>
                </div>
            </div>

            <!-- Bloque Cuenta y Rol -->
            <div>
                <h3 class="text-xs font-bold text-slate-700 uppercase tracking-wider mb-3 pb-1 border-b border-slate-100 flex items-center gap-1.5">
                    <i class="bi bi-shield-lock-fill text-blue-600"></i> Credenciales y Rol de Seguridad
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1.5">
                            Correo Institucional / Login <span class="text-rose-500">*</span>
                        </label>
                        <input type="email" 
                               @bind="_model.Email" 
                               required 
                               placeholder="carlos.gomez@empresa.com"
                               class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm font-mono text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                        <p class="text-[10px] text-slate-400 mt-1">Se utilizará para iniciar sesión en la plataforma.</p>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1.5">
                            Rol del Sistema <span class="text-rose-500">*</span>
                        </label>
                        <select @bind="_roleString" 
                                class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500">
                            <option value="Cashier">Cajero (Punto de Venta POS)</option>
                            <option value="Supervisor">Supervisor (Auditorías e Inventario)</option>
                            <option value="Admin">Administrador (Acceso Total)</option>
                        </select>
                        <p class="text-[10px] text-slate-400 mt-1">Determina los módulos y permisos accesibles en el menú.</p>
                    </div>
                </div>
            </div>

            <!-- Bloque Contraseña -->
            <div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1.5">
                            Contraseña Inicial <span class="text-rose-500">*</span>
                        </label>
                        <input type="password" 
                               @bind="_model.Password" 
                               required 
                               placeholder="••••••••"
                               class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm font-mono text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1.5">
                            Confirmar Contraseña <span class="text-rose-500">*</span>
                        </label>
                        <input type="password" 
                               @bind="_confirmPassword" 
                               required 
                               placeholder="••••••••"
                               class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm font-mono text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                    </div>
                </div>
            </div>

            <!-- Acciones -->
            <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
                <a href="/usuarios" class="px-4 py-2.5 rounded-xl text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 transition-colors border border-slate-200">
                    Cancelar
                </a>
                <button type="submit" 
                        disabled="@_isLoading"
                        class="px-5 py-2.5 rounded-xl text-sm font-bold text-white bg-blue-600 hover:bg-blue-700 shadow-md shadow-blue-600/20 transition-all flex items-center gap-2 disabled:opacity-50">
                    @if (_isLoading)
                    {
                        <div class="inline-block animate-spin rounded-full h-4 w-4 border-2 border-white border-t-transparent"></div>
                        <span>Creando Usuario...</span>
                    }
                    else
                    {
                        <i class="bi bi-person-check-fill"></i>
                        <span>Crear Usuario</span>
                    }
                </button>
            </div>

        </form>
    </div>
</div>