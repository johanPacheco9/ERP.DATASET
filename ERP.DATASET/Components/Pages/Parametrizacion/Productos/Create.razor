@page "/inventario/productos/nuevossss"
@using ERP.TRAN.CrossLayers.API.Inventario.Producto.Requests
@using ProductoBaseService = ERP.DATA.Services.InventarioService.ProductoBaseService.ProductoBaseService
@inject ProductoBaseService ProductoBaseSvc
@inject NavigationManager Nav

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-0">Nuevo Producto de Catálogo</h4>
            <small class="text-muted">Defina las características base de la línea de productos</small>
        </div>
        <button class="btn btn-outline-secondary btn-sm" @onclick="Volver">
            <i class="bi bi-arrow-left"></i> Cancelar
        </button>
    </div>

    @if (_errorMensaje is not null)
    {
        <div class="alert alert-danger alert-dismissible mb-4">
            @_errorMensaje
            <button class="btn-close" @onclick="() => _errorMensaje = null"></button>
        </div>
    }

    <EditForm Model="_request" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        <div class="row">
            @* SECCIÓN IZQUIERDA: IDENTIDAD *@
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white py-3">
                        <h6 class="mb-0 fw-bold text-primary">Información General</h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Código Base (Prefijo)</label>
                                <InputText @bind-Value="_request.Codigo" class="form-control text-uppercase" placeholder="EJ: PROD-001" />
                                <ValidationMessage For="@(() => _request.Codigo)" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Nombre del Producto</label>
                                <InputText @bind-Value="_request.Nombre" class="form-control" placeholder="Nombre comercial" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Descripción</label>
                                <InputTextArea @bind-Value="_request.Descripcion" class="form-control" rows="2" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Categoría</label>
                                <select class="form-select" @bind="_request.CategoriasIds">
                                    <option value="0">-- Seleccione --</option>
                                    @foreach (var categoria in _categorias)
                                    {
                                        <option value="@categoria.Id">@categoria.Nombre</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Proveedor Principal</label>
                                <select class="form-select" @bind="_request.ProveedorId">
                                    <option value="">-- Opcional --</option>
                                    @* Aquí iterarías tus proveedores *@
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3">
                        <h6 class="mb-0 fw-bold text-primary">Fiscal y Precios</h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Costo Unitario</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <InputNumber @bind-Value="_request.Costo_Unitario" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Precio Venta</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <InputNumber @bind-Value="_request.Precio_Venta" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">% IVA</label>
                                <InputNumber @bind-Value="_request.PorcentajeIVA" class="form-control" step="0.01" />
                            </div>
                            <div class="col-md-6">
                                <div class="form-check form-switch mt-2">
                                    <InputCheckbox @bind-Value="_request.ExentoIVA" class="form-check-input" id="exento" />
                                    <label class="form-check-label" for="exento">Exento de IVA</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small">Código Tributario (DIAN)</label>
                                <InputText @bind-Value="_request.CodigoTributario" class="form-control form-control-sm" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* SECCIÓN DERECHA: LOGÍSTICA *@
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white py-3">
                        <h6 class="mb-0 fw-bold text-primary">Logística y Físicos</h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Unidad de Medida</label>
                                <select class="form-select" @bind="_request.Unidad_Medida">
                                    <option value="UND">Unidades (UND)</option>
                                    <option value="KG">Kilogramos (KG)</option>
                                    <option value="MTS">Metros (MTS)</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Peso (kg)</label>
                                <InputNumber @bind-Value="_request.Peso" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Volumen</label>
                                <InputNumber @bind-Value="_request.Volumen" class="form-control" />
                            </div>
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <InputCheckbox @bind-Value="_request.EsPerecedero" class="form-check-input" id="perecedero" />
                                    <label class="form-check-label" for="perecedero">Producto Perecedero</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary py-3" disabled="@_procesando">
                        @if (_procesando)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <i class="bi bi-cloud-check"></i> <span>Crear Producto</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </EditForm>
</div>